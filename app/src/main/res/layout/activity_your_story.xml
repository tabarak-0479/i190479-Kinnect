<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#111111">
  <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_margin="8dp" android:background="@drawable/viewfinder" android:clipToOutline="true">
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/landscape_green" android:scaleType="centerCrop" android:contentDescription="@string/ui_landscape_illustration" android:id="@+id/storyImage" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="10dp" android:paddingTop="10dp" android:baselineAligned="false">
        <View android:layout_width="0dp" android:layout_height="3dp" android:layout_weight="1" android:background="#FFFFFF" android:alpha="1" android:layout_marginEnd="4dp" android:id="@+id/storySegment0" />
      </LinearLayout>
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="10dp" android:baselineAligned="false">
        <TextView android:layout_width="40dp" android:layout_height="40dp" android:text="@string/ui_jw" android:textSize="18sp" android:textColor="#FFFFFF" android:background="@drawable/circle_teal" android:gravity="center" android:textStyle="bold" android:id="@+id/storyPersonAvatar" app:autoSizeTextType="uniform" app:autoSizeMinTextSize="6sp" app:autoSizeMaxTextSize="18sp" app:autoSizeStepGranularity="1sp" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:paddingStart="10dp">
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_your_story" android:textSize="16sp" android:textColor="#FFFFFF" android:textStyle="bold" android:id="@+id/storyPerson" />
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_11h_close_friends" android:textSize="12sp" android:textColor="#FFFFFF" android:id="@+id/storyAge" />
        </LinearLayout>
        <ImageButton android:layout_width="48dp" android:layout_height="48dp" android:id="@+id/btnBack" android:src="@drawable/ic_close" android:background="@android:color/transparent" android:padding="12dp" android:contentDescription="@string/ui_back" app:tint="#FFFFFF" />
      </LinearLayout>
    </LinearLayout>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_saturday_plans" android:textSize="24sp" android:textColor="#FFFFFF" android:id="@+id/storyCaption" android:textStyle="bold" android:background="@drawable/story_caption" android:padding="12dp" android:layout_gravity="center" android:rotation="3" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="34sp" android:textColor="#FFFFFF" android:id="@+id/storySticker" android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="90dp" android:visibility="gone" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="14sp" android:textColor="#FFFFFF" android:id="@+id/storyMusic" android:background="@drawable/dark_pill" android:padding="8dp" android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="40dp" android:visibility="gone" />
    <ImageButton android:layout_width="18dp" android:layout_height="18dp" android:id="@+id/floatingHeart0" android:src="@drawable/ic_heart" android:background="@drawable/reaction_love" android:padding="4dp" android:contentDescription="@string/ui_floatingheart0" android:layout_gravity="bottom|start" android:layout_marginBottom="150dp" android:layout_marginStart="20dp" android:importantForAccessibility="no" app:tint="#FFFFFF" android:clickable="false" android:focusable="false" />
    <ImageButton android:layout_width="20dp" android:layout_height="20dp" android:id="@+id/floatingHeart1" android:src="@drawable/ic_heart" android:background="@drawable/reaction_love" android:padding="4dp" android:contentDescription="@string/ui_floatingheart1" android:layout_gravity="bottom|start" android:layout_marginBottom="124dp" android:layout_marginStart="33dp" android:importantForAccessibility="no" app:tint="#FFFFFF" android:clickable="false" android:focusable="false" />
    <ImageButton android:layout_width="22dp" android:layout_height="22dp" android:id="@+id/floatingHeart2" android:src="@drawable/ic_heart" android:background="@drawable/reaction_love" android:padding="4dp" android:contentDescription="@string/ui_floatingheart2" android:layout_gravity="bottom|start" android:layout_marginBottom="98dp" android:layout_marginStart="20dp" android:importantForAccessibility="no" app:tint="#FFFFFF" android:clickable="false" android:focusable="false" />
    <ImageButton android:layout_width="24dp" android:layout_height="24dp" android:id="@+id/floatingHeart3" android:src="@drawable/ic_heart" android:background="@drawable/reaction_love" android:padding="4dp" android:contentDescription="@string/ui_floatingheart3" android:layout_gravity="bottom|start" android:layout_marginBottom="72dp" android:layout_marginStart="33dp" android:importantForAccessibility="no" app:tint="#FFFFFF" android:clickable="false" android:focusable="false" />
    <ImageButton android:layout_width="26dp" android:layout_height="26dp" android:id="@+id/floatingHeart4" android:src="@drawable/ic_heart" android:background="@drawable/reaction_love" android:padding="4dp" android:contentDescription="@string/ui_floatingheart4" android:layout_gravity="bottom|start" android:layout_marginBottom="46dp" android:layout_marginStart="20dp" android:importantForAccessibility="no" app:tint="#FFFFFF" android:clickable="false" android:focusable="false" />
  </FrameLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="10dp" android:baselineAligned="false">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:id="@+id/btnSeen" android:clickable="true" android:focusable="true">
      <FrameLayout android:layout_width="match_parent" android:layout_height="48dp">
        <TextView android:layout_width="24dp" android:layout_height="24dp" android:text="@string/ui_ak" android:textSize="18sp" android:textColor="#FFFFFF" android:background="@drawable/circle_red" android:gravity="center" android:textStyle="bold" android:layout_gravity="center_vertical|start" app:autoSizeTextType="uniform" app:autoSizeMinTextSize="6sp" app:autoSizeMaxTextSize="18sp" app:autoSizeStepGranularity="1sp" />
        <TextView android:layout_width="24dp" android:layout_height="24dp" android:text="@string/ui_lm" android:textSize="18sp" android:textColor="#FFFFFF" android:background="@drawable/circle_purple" android:gravity="center" android:textStyle="bold" android:layout_gravity="center_vertical|start" android:layout_marginStart="18dp" app:autoSizeTextType="uniform" app:autoSizeMinTextSize="6sp" app:autoSizeMaxTextSize="18sp" app:autoSizeStepGranularity="1sp" />
        <TextView android:layout_width="24dp" android:layout_height="24dp" android:text="@string/ui_of" android:textSize="18sp" android:textColor="#FFFFFF" android:background="@drawable/circle_green" android:gravity="center" android:textStyle="bold" android:layout_gravity="center_vertical|start" android:layout_marginStart="36dp" app:autoSizeTextType="uniform" app:autoSizeMinTextSize="6sp" app:autoSizeMaxTextSize="18sp" app:autoSizeStepGranularity="1sp" />
      </FrameLayout>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_seen_by_24" android:textSize="12sp" android:textColor="#FFFFFF" android:gravity="center" />
    </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:id="@+id/btnCreate" android:clickable="true" android:focusable="true" android:contentDescription="@string/ui_create">
      <ImageButton android:layout_width="match_parent" android:layout_height="48dp" android:id="@+id/btnCreateIcon" android:src="@drawable/ic_movie" android:background="@android:color/transparent" android:padding="12dp" android:contentDescription="@string/ui_createicon" app:tint="#FFFFFF" android:clickable="false" android:focusable="false" android:importantForAccessibility="no" />
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_create" android:textSize="12sp" android:textColor="#FFFFFF" android:gravity="center" />
    </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:id="@+id/btnHighlight" android:clickable="true" android:focusable="true" android:contentDescription="@string/ui_highlight">
      <ImageButton android:layout_width="match_parent" android:layout_height="48dp" android:id="@+id/btnHighlightIcon" android:src="@drawable/ic_heart" android:background="@android:color/transparent" android:padding="12dp" android:contentDescription="@string/ui_highlighticon" app:tint="#FFFFFF" android:clickable="false" android:focusable="false" android:importantForAccessibility="no" />
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_highlight" android:textSize="12sp" android:textColor="#FFFFFF" android:gravity="center" />
    </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:id="@+id/btnSend" android:clickable="true" android:focusable="true" android:contentDescription="@string/ui_send">
      <ImageButton android:layout_width="match_parent" android:layout_height="48dp" android:id="@+id/btnSendIcon" android:src="@drawable/ic_send" android:background="@android:color/transparent" android:padding="12dp" android:contentDescription="@string/ui_sendicon" app:tint="#FFFFFF" android:clickable="false" android:focusable="false" android:importantForAccessibility="no" />
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_send" android:textSize="12sp" android:textColor="#FFFFFF" android:gravity="center" />
    </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:id="@+id/btnOptions" android:clickable="true" android:focusable="true" android:contentDescription="@string/ui_more">
      <ImageButton android:layout_width="match_parent" android:layout_height="48dp" android:id="@+id/btnOptionsIcon" android:src="@drawable/ic_more" android:background="@android:color/transparent" android:padding="12dp" android:contentDescription="@string/ui_optionsicon" app:tint="#FFFFFF" android:clickable="false" android:focusable="false" android:importantForAccessibility="no" />
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_more" android:textSize="12sp" android:textColor="#FFFFFF" android:gravity="center" />
    </LinearLayout>
  </LinearLayout>
</LinearLayout>