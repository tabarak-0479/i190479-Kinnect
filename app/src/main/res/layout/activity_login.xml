<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/background">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/background" android:padding="24dp" android:orientation="vertical">
    <TextView android:id="@+id/tvLanguage" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="English (UK)⌄" android:textColor="@color/dark_gray" android:textSize="13sp" android:layout_gravity="center_horizontal" />
    <ImageView android:id="@+id/imgLogo" android:layout_width="76dp" android:layout_height="58dp" android:layout_marginTop="22dp" android:background="@drawable/rounded_teal" android:padding="13dp" android:src="@drawable/kinnect_logo" android:contentDescription="Kinnect logo" android:layout_gravity="center_horizontal" />
    <LinearLayout android:id="@+id/loginArea" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="30dp" android:orientation="vertical">
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="RECENT LOGIN" android:textColor="@color/dark_gray" android:textSize="12sp" android:textStyle="bold" />
      <LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="8dp" android:background="@drawable/rounded_white" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="12dp" android:id="@+id/btnRecentAccount" android:clickable="true" android:focusable="true" android:contentDescription="Log in as Jacob West">
        <TextView android:layout_width="46dp" android:layout_height="46dp" android:background="@drawable/rounded_teal" android:gravity="center" android:text="JW" android:textColor="@color/white" android:textSize="16sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Jacob West" android:textColor="@color/black" android:textSize="15sp" android:textStyle="bold" />
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tap to log in" android:textColor="@color/gray" android:textSize="12sp" />
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="•••" android:textColor="@color/gray" android:textSize="18sp" />
      </LinearLayout>
      <EditText android:id="@+id/etEmail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/rounded_white" android:hint="Mobile number or email" android:inputType="textEmailAddress" android:paddingHorizontal="14dp" android:text="jacob.west@mail.com" android:textColor="@color/dark_gray" android:textColorHint="@color/gray" android:textSize="14sp" android:minHeight="48dp" android:paddingVertical="8dp" android:importantForAutofill="no" />
      <FrameLayout android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:background="@drawable/rounded_white">
        <EditText android:id="@+id/etPassword" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent" android:hint="Password" android:inputType="textPassword" android:paddingHorizontal="14dp" android:text="password" android:textColor="@color/dark_gray" android:textColorHint="@color/gray" android:textSize="14sp" android:paddingEnd="48dp" android:importantForAutofill="no" />
        <ImageButton android:id="@+id/btnPasswordEye" android:layout_width="48dp" android:layout_height="match_parent" android:layout_gravity="end" android:src="@drawable/ic_visibility" android:padding="14dp" android:contentDescription="Show password" android:background="@android:color/transparent" app:tint="#777A73" />
      </FrameLayout>
      <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnLogin" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="12dp" android:background="@drawable/rounded_teal" android:text="Log in" android:textAllCaps="false" android:textColor="@color/white" android:textSize="15sp" android:textStyle="bold" android:backgroundTint="@null" android:letterSpacing="0" app:backgroundTint="@null" />
      <TextView android:id="@+id/tvForgotPassword" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:layout_marginTop="12dp" android:text="Forgot password?" android:textColor="@color/kinnect_teal" android:textSize="13sp" android:textStyle="bold" />
    </LinearLayout>
    <Space android:layout_width="match_parent" android:layout_height="60dp" />
    <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnCreateAccount" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginBottom="12dp" android:background="@drawable/rounded_teal_outline" android:text="Create new account" android:textAllCaps="false" android:textColor="@color/kinnect_teal" android:textSize="14sp" android:textStyle="bold" android:backgroundTint="@null" android:letterSpacing="0" app:backgroundTint="@null" />
    <TextView android:id="@+id/tvFooter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="◉  Kinnect · from SMD" android:textColor="@color/gray" android:textSize="12sp" android:layout_gravity="center_horizontal" />
  </LinearLayout>
</ScrollView>