<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/background">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/background" android:padding="20dp" android:orientation="vertical" android:paddingTop="32dp" android:paddingBottom="20dp">
    <TextView android:id="@+id/tvLanguage" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_english_uk" android:textColor="@color/dark_gray" android:textSize="13sp" android:layout_gravity="center_horizontal" android:drawableEnd="@drawable/ic_chevron_down" android:drawablePadding="6dp" android:clickable="true" android:focusable="true" android:minHeight="40dp" android:gravity="center" />
    <ImageView android:id="@+id/imgLogo" android:layout_width="76dp" android:layout_height="76dp" android:layout_marginTop="40dp" android:background="@drawable/auth_logo" android:padding="13dp" android:src="@drawable/kinnect_logo" android:contentDescription="@string/ui_kinnect_logo" android:layout_gravity="center_horizontal" />
    <LinearLayout android:id="@+id/loginArea" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="40dp" android:orientation="vertical">
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_recent_login" android:textColor="@color/dark_gray" android:textSize="12sp" android:textStyle="bold" />
      <LinearLayout android:layout_width="match_parent" android:layout_height="80dp" android:layout_marginTop="12dp" android:background="@drawable/rounded_white" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="12dp" android:id="@+id/btnRecentAccount" android:clickable="true" android:focusable="true" android:contentDescription="@string/ui_log_in_as_jacob_west" android:baselineAligned="false">
        <FrameLayout android:layout_width="60dp" android:layout_height="60dp">
          <TextView android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/rounded_teal" android:gravity="center" android:text="@string/ui_jw" android:textColor="@color/white" android:textSize="16sp" android:textStyle="bold" android:layout_gravity="center" />
          <TextView android:layout_width="20dp" android:layout_height="20dp" android:text="@string/ui_2" android:textSize="12sp" android:gravity="center" android:textColor="#FFFFFF" android:textStyle="bold" android:background="@drawable/circle_badge" android:layout_gravity="top|end" android:contentDescription="@string/ui_2_new_account_notifications" />
        </FrameLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_jacob_west" android:textColor="@color/black" android:textSize="15sp" android:textStyle="bold" />
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_tap_to_log_in" android:textColor="@color/gray" android:textSize="12sp" />
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_symbol" android:textColor="@color/gray" android:textSize="18sp" />
      </LinearLayout>
      <FrameLayout android:layout_width="match_parent" android:layout_height="56dp" android:background="@drawable/rounded_white" android:layout_marginTop="20dp">
        <EditText android:id="@+id/etEmail" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent" android:hint="@string/ui_mobile_number_or_email" android:inputType="textEmailAddress" android:paddingHorizontal="14dp" android:text="@string/ui_jacob_west_mail_com" android:textColor="@color/dark_gray" android:textColorHint="@color/gray" android:textSize="16sp" android:minHeight="48dp" android:paddingVertical="8dp" android:importantForAutofill="no" android:paddingTop="18dp" android:paddingBottom="2dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="16dp" android:layout_marginStart="14dp" android:layout_marginTop="6dp" android:text="@string/ui_mobile_number_or_email" android:textSize="12sp" android:textColor="#62655F" android:importantForAccessibility="no" />
      </FrameLayout>
      <FrameLayout android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="8dp" android:background="@drawable/rounded_white">
        <EditText android:id="@+id/etPassword" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent" android:hint="@string/ui_password_8be3c9" android:inputType="textPassword" android:paddingHorizontal="14dp" android:text="@string/ui_password" android:textColor="@color/dark_gray" android:textColorHint="@color/gray" android:textSize="16sp" android:paddingEnd="48dp" android:importantForAutofill="no" android:paddingTop="18dp" android:paddingBottom="2dp" />
        <ImageButton android:id="@+id/btnPasswordEye" android:layout_width="48dp" android:layout_height="match_parent" android:layout_gravity="end" android:src="@drawable/ic_visibility" android:padding="14dp" android:contentDescription="@string/ui_show_password" android:background="@android:color/transparent" app:tint="#777A73" />
        <TextView android:layout_width="wrap_content" android:layout_height="16dp" android:layout_marginStart="14dp" android:layout_marginTop="6dp" android:text="@string/ui_password_8be3c9" android:textSize="12sp" android:textColor="#62655F" android:importantForAccessibility="no" />
      </FrameLayout>
      <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnLogin" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="12dp" android:background="@drawable/rounded_teal" android:text="@string/ui_log_in" android:textAllCaps="false" android:textColor="@color/white" android:textSize="15sp" android:textStyle="bold" android:backgroundTint="@null" android:letterSpacing="0" app:backgroundTint="@null" />
      <TextView android:id="@+id/tvForgotPassword" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:layout_marginTop="24dp" android:text="@string/ui_forgot_password" android:textColor="@color/kinnect_teal" android:textSize="13sp" android:textStyle="bold" />
    </LinearLayout>
    <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="32dp" />
    <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnCreateAccount" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginBottom="12dp" android:background="@drawable/rounded_teal_outline" android:text="@string/ui_create_new_account" android:textAllCaps="false" android:textColor="@color/kinnect_teal" android:textSize="14sp" android:textStyle="bold" android:backgroundTint="@null" android:letterSpacing="0" app:backgroundTint="@null" />
    <LinearLayout android:id="@+id/tvFooter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/gray" android:textSize="12sp" android:layout_gravity="center_horizontal" android:orientation="horizontal" android:gravity="center" android:baselineAligned="false">
      <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/kinnect_logo" android:importantForAccessibility="no" app:tint="#62655F" />
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_kinnect_from_smd" android:textSize="13sp" android:textColor="#62655F" android:paddingStart="8dp" />
    </LinearLayout>
  </LinearLayout>
</ScrollView>