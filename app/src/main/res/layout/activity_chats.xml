  <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#DFDFD8" />
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:layout_width="0dp" android:layout_height="48dp" android:text="Chats" android:textSize="14sp" android:textColor="#252722" android:id="@+id/btnChatsTab" android:gravity="center" android:textStyle="bold" android:background="@drawable/button_pale" android:clickable="true" android:focusable="true" android:layout_weight="1" />
