<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#0B5F63">
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_end_to_end_encrypted" android:textSize="13sp" android:textColor="#BAD7D8" android:gravity="center" android:padding="28dp" />
  <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
  <FrameLayout android:layout_width="196dp" android:layout_height="196dp" android:layout_gravity="center_horizontal" android:background="@drawable/call_halo_outer">
    <FrameLayout android:layout_width="172dp" android:layout_height="172dp" android:layout_gravity="center" android:background="@drawable/call_halo_inner">
      <TextView android:layout_width="148dp" android:layout_height="148dp" android:text="@string/ui_am" android:textSize="48sp" android:textColor="#FFFFFF" android:gravity="center" android:textStyle="bold" android:background="@drawable/call_avatar" android:layout_gravity="center" android:id="@+id/callAvatar" />
    </FrameLayout>
  </FrameLayout>
  <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_gravity="center_horizontal" android:paddingTop="20dp" android:baselineAligned="false">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_ammi" android:textSize="30sp" android:textColor="#FFFFFF" android:textStyle="bold" android:id="@+id/callName" />
    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_heart" android:padding="4dp" android:background="@drawable/reaction_love" android:layout_marginStart="8dp" android:contentDescription="@string/ui_favorite_contact" app:tint="#FFFFFF" />
  </LinearLayout>
  <Chronometer android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/callDuration" android:text="@string/ui_03_12" android:textSize="20sp" android:textColor="#BFDCDD" android:layout_gravity="center_horizontal" android:layout_marginTop="10dp" />
  <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1.6" />
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="24dp" android:paddingBottom="24dp" android:baselineAligned="false">
    <FrameLayout android:layout_width="0dp" android:layout_height="88dp" android:layout_weight="1">
      <ImageButton android:layout_width="56dp" android:layout_height="56dp" android:id="@+id/btnKeypad" android:src="@drawable/ic_keypad" android:background="@drawable/call_control" android:padding="18dp" android:contentDescription="@string/ui_keypad" android:layout_gravity="center" app:tint="#FFFFFF" />
    </FrameLayout>
    <FrameLayout android:layout_width="0dp" android:layout_height="88dp" android:layout_weight="1">
      <ImageButton android:layout_width="56dp" android:layout_height="56dp" android:id="@+id/btnMute" android:src="@drawable/ic_mic" android:background="@drawable/call_control" android:padding="18dp" android:contentDescription="@string/ui_mic" android:layout_gravity="center" app:tint="#FFFFFF" />
    </FrameLayout>
    <FrameLayout android:layout_width="0dp" android:layout_height="88dp" android:layout_weight="1">
      <ImageButton android:layout_width="80dp" android:layout_height="80dp" android:id="@+id/btnEndCall" android:src="@drawable/ic_end_phone" android:background="@drawable/call_end" android:padding="18dp" android:contentDescription="@string/ui_end_phone" android:layout_gravity="center" app:tint="#FFFFFF" />
    </FrameLayout>
    <FrameLayout android:layout_width="0dp" android:layout_height="88dp" android:layout_weight="1">
      <ImageButton android:layout_width="56dp" android:layout_height="56dp" android:id="@+id/btnSpeaker" android:src="@drawable/ic_speaker" android:background="@drawable/call_control" android:padding="18dp" android:contentDescription="@string/ui_speaker" android:layout_gravity="center" app:tint="#FFFFFF" />
    </FrameLayout>
  </LinearLayout>
</LinearLayout>