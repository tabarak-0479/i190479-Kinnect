<?xml version="1.0" ?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#FFFFFF">
    <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingEnd="12dp">
                <ImageButton android:layout_width="48dp" android:layout_height="48dp" android:id="@+id/btnBack" android:src="@drawable/ic_back" android:background="?attr/selectableItemBackgroundBorderless" android:padding="12dp" android:contentDescription="Back"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="Lina’s post" android:textSize="20sp" android:textColor="#252722" android:layout_weight="1" android:textStyle="bold"/>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#DFDFD8"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp">
                <TextView android:layout_width="44dp" android:layout_height="44dp" android:text="LM" android:textSize="18sp" android:textColor="#FFFFFF" android:background="@drawable/circle_purple" android:gravity="center" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Lina Marsh is at Clifton Beach" android:textSize="18sp" android:textColor="#252722" android:textStyle="bold" android:padding="16dp"/>
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sunset walk with the crew. Worth every grain of sand in my shoes." android:textSize="14sp" android:textColor="#252722" android:padding="16dp"/>
            <ImageView android:layout_width="match_parent" android:layout_height="300dp" android:src="@drawable/landscape_sand" android:scaleType="centerCrop" android:contentDescription="Landscape illustration"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Aisha and 1.2K others         86 comments" android:textSize="14sp" android:textColor="#252722" android:padding="16dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <ImageButton android:layout_width="48dp" android:layout_height="48dp" android:id="@+id/btnLike" android:src="@drawable/ic_like" android:background="?attr/selectableItemBackgroundBorderless" android:padding="12dp" android:contentDescription="Like"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Like" android:textSize="14sp" android:textColor="#252722"/>
                <ImageButton android:layout_width="48dp" android:layout_height="48dp" android:id="@+id/btnComments" android:src="@drawable/ic_comment" android:background="?attr/selectableItemBackgroundBorderless" android:padding="12dp" android:contentDescription="Comment"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Comment" android:textSize="14sp" android:textColor="#252722"/>
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Most relevant" android:textSize="18sp" android:textColor="#252722" android:textStyle="bold" android:padding="16dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="12dp">
                <TextView android:layout_width="32dp" android:layout_height="32dp" android:text="AK" android:textSize="18sp" android:textColor="#FFFFFF" android:background="@drawable/circle_red" android:gravity="center" android:textStyle="bold"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:padding="12dp" android:background="@drawable/bubble_in" android:layout_marginStart="8dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Aisha Khan" android:textSize="14sp" android:textColor="#252722" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="That sky is unreal." android:textSize="14sp" android:textColor="#252722"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2h    Like    Reply" android:textSize="12sp" android:textColor="#252722" android:paddingTop="8dp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="#55000000"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/card_white" android:padding="6dp" android:layout_gravity="center" android:layout_margin="16dp">
            <TextView android:layout_width="0dp" android:layout_height="56dp" android:text="👍" android:textSize="28sp" android:textColor="#252722" android:layout_weight="1" android:gravity="center" android:id="@+id/reaction0" android:clickable="true" android:focusable="true" android:contentDescription="Like"/>
            <TextView android:layout_width="0dp" android:layout_height="56dp" android:text="♥" android:textSize="28sp" android:textColor="#252722" android:layout_weight="1" android:gravity="center" android:id="@+id/reaction1" android:clickable="true" android:focusable="true" android:contentDescription="Love"/>
            <TextView android:layout_width="0dp" android:layout_height="56dp" android:text="😄" android:textSize="28sp" android:textColor="#252722" android:layout_weight="1" android:gravity="center" android:id="@+id/reaction2" android:clickable="true" android:focusable="true" android:contentDescription="Haha"/>
            <TextView android:layout_width="0dp" android:layout_height="56dp" android:text="😮" android:textSize="28sp" android:textColor="#252722" android:layout_weight="1" android:gravity="center" android:id="@+id/reaction3" android:clickable="true" android:focusable="true" android:contentDescription="Wow"/>
            <TextView android:layout_width="0dp" android:layout_height="56dp" android:text="😢" android:textSize="28sp" android:textColor="#252722" android:layout_weight="1" android:gravity="center" android:id="@+id/reaction4" android:clickable="true" android:focusable="true" android:contentDescription="Sad"/>
            <TextView android:layout_width="0dp" android:layout_height="56dp" android:text="😡" android:textSize="28sp" android:textColor="#252722" android:layout_weight="1" android:gravity="center" android:id="@+id/reaction5" android:clickable="true" android:focusable="true" android:contentDescription="Angry"/>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
