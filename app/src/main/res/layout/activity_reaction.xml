<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#FFFFFF">
  <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingEnd="12dp" android:minHeight="56dp" android:baselineAligned="false">
        <ImageButton android:layout_width="48dp" android:layout_height="48dp" android:id="@+id/btnBack" android:src="@drawable/ic_back" android:background="?attr/selectableItemBackgroundBorderless" android:padding="12dp" android:contentDescription="@string/ui_back" app:tint="#0B5F63" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/ui_linas_post" android:textSize="20sp" android:textColor="#252722" android:layout_weight="1" android:textStyle="bold" />
      </LinearLayout>
      <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#DFDFD8" />
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp" android:baselineAligned="false">
        <TextView android:layout_width="40dp" android:layout_height="40dp" android:text="@string/ui_lm" android:textSize="18sp" android:textColor="#FFFFFF" android:background="@drawable/circle_purple" android:gravity="center" android:textStyle="bold" app:autoSizeTextType="uniform" app:autoSizeMinTextSize="6sp" app:autoSizeMaxTextSize="18sp" app:autoSizeStepGranularity="1sp" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:paddingStart="10dp">
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_lina_marsh_is_at_clifton_beach" android:textSize="16sp" android:textColor="#252722" android:textStyle="bold" />
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_2h_public" android:textSize="13sp" android:textColor="#62655F" />
        </LinearLayout>
        <ImageButton android:layout_width="36dp" android:layout_height="48dp" android:id="@+id/btnPostMore" android:src="@drawable/ic_more" android:background="@android:color/transparent" android:padding="12dp" android:contentDescription="@string/ui_more" app:tint="#0B5F63" />
        <ImageButton android:layout_width="36dp" android:layout_height="48dp" android:id="@+id/btnHidePost" android:src="@drawable/ic_close" android:background="@android:color/transparent" android:padding="12dp" android:contentDescription="@string/ui_close" app:tint="#0B5F63" />
      </LinearLayout>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_sunset_walk_with_the_crew_worth_every_grain_o" android:textSize="16sp" android:textColor="#252722" android:padding="16dp" />
      <ImageView android:layout_width="match_parent" android:layout_height="330dp" android:src="@drawable/landscape_sand" android:scaleType="centerCrop" android:contentDescription="@string/ui_landscape_illustration" />
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="12dp" android:baselineAligned="false">
        <FrameLayout android:layout_width="48dp" android:layout_height="20dp">
          <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/reaction_like" android:importantForAccessibility="no" />
          <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/reaction_love_icon" android:importantForAccessibility="no" android:layout_marginStart="14dp" />
          <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/reaction_haha" android:importantForAccessibility="no" android:layout_marginStart="28dp" />
        </FrameLayout>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/ui_aisha_and_1_2k_others" android:textSize="13sp" android:textColor="#252722" android:layout_weight="1" android:paddingStart="4dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_86_comments_12_shares" android:textSize="13sp" android:textColor="#252722" />
      </LinearLayout>
      <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#DFDFD8" />
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="horizontal" android:gravity="center" android:id="@+id/btnLike" android:clickable="true" android:focusable="true" android:contentDescription="@string/ui_like" android:minHeight="48dp" android:baselineAligned="false">
          <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_like" android:importantForAccessibility="no" android:id="@+id/btnLikeIcon" app:tint="#62655F" />
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_like" android:textSize="14sp" android:textColor="#252722" android:paddingStart="6dp" android:id="@+id/btnLikeLabel" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="horizontal" android:gravity="center" android:id="@+id/btnComments" android:clickable="true" android:focusable="true" android:contentDescription="@string/ui_comment" android:minHeight="48dp" android:baselineAligned="false">
          <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_comment" android:importantForAccessibility="no" android:id="@+id/btnCommentsIcon" app:tint="#62655F" />
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_comment" android:textSize="14sp" android:textColor="#252722" android:paddingStart="6dp" android:id="@+id/btnCommentsLabel" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="horizontal" android:gravity="center" android:id="@+id/btnShare" android:clickable="true" android:focusable="true" android:contentDescription="@string/ui_share" android:minHeight="48dp">
          <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_share" android:importantForAccessibility="no" app:tint="#62655F" />
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_share" android:textSize="14sp" android:textColor="#252722" android:paddingStart="6dp" />
        </LinearLayout>
      </LinearLayout>
      <View android:layout_width="match_parent" android:layout_height="8dp" android:background="#DFDFD8" />
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_most_relevant" android:textSize="18sp" android:textColor="#252722" android:textStyle="bold" android:padding="16dp" />
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp" android:baselineAligned="false">
        <TextView android:layout_width="32dp" android:layout_height="32dp" android:text="@string/ui_ak" android:textSize="18sp" android:textColor="#FFFFFF" android:background="@drawable/circle_red" android:gravity="center" android:textStyle="bold" app:autoSizeTextType="uniform" app:autoSizeMinTextSize="6sp" app:autoSizeMaxTextSize="18sp" app:autoSizeStepGranularity="1sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" android:background="@drawable/bubble_in" android:layout_marginStart="8dp">
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_aisha_khan" android:textSize="16sp" android:textColor="#252722" android:textStyle="bold" />
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_that_sky_is_unreal" android:textSize="16sp" android:textColor="#252722" />
        </LinearLayout>
      </LinearLayout>
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="#55000000" android:id="@+id/reactionScrim" android:clickable="true" android:focusable="true" android:contentDescription="@string/ui_dismiss_reaction_picker" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="92dp" android:layout_gravity="center" android:layout_marginHorizontal="14dp" android:translationY="40dp">
      <View android:layout_width="match_parent" android:layout_height="56dp" android:layout_gravity="bottom" android:background="@drawable/reaction_pill" />
      <LinearLayout android:layout_width="match_parent" android:layout_height="92dp" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
        <FrameLayout android:layout_width="0dp" android:layout_height="92dp" android:layout_weight="1" android:id="@+id/reaction0" android:clickable="true" android:focusable="true" android:contentDescription="@string/ui_like">
          <ImageView android:layout_width="36dp" android:layout_height="36dp" android:src="@drawable/reaction_like" android:layout_gravity="center_horizontal|bottom" android:layout_marginBottom="10dp" android:contentDescription="@string/ui_like" />
        </FrameLayout>
        <FrameLayout android:layout_width="0dp" android:layout_height="92dp" android:layout_weight="1" android:id="@+id/reaction1" android:clickable="true" android:focusable="true" android:contentDescription="@string/ui_love">
          <TextView android:layout_width="48dp" android:layout_height="24dp" android:text="@string/ui_love" android:textSize="12sp" android:textColor="#FFFFFF" android:textStyle="bold" android:gravity="center" android:background="@drawable/dark_pill" android:layout_gravity="top|center_horizontal" />
          <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/reaction_love_icon" android:layout_gravity="center_horizontal|bottom" android:layout_marginBottom="20dp" android:contentDescription="@string/ui_love" />
        </FrameLayout>
        <FrameLayout android:layout_width="0dp" android:layout_height="92dp" android:layout_weight="1" android:id="@+id/reaction2" android:clickable="true" android:focusable="true" android:contentDescription="@string/ui_haha">
          <ImageView android:layout_width="36dp" android:layout_height="36dp" android:src="@drawable/reaction_haha" android:layout_gravity="center_horizontal|bottom" android:layout_marginBottom="10dp" android:contentDescription="@string/ui_haha" />
        </FrameLayout>
        <FrameLayout android:layout_width="0dp" android:layout_height="92dp" android:layout_weight="1" android:id="@+id/reaction3" android:clickable="true" android:focusable="true" android:contentDescription="@string/ui_wow">
          <ImageView android:layout_width="36dp" android:layout_height="36dp" android:src="@drawable/reaction_wow" android:layout_gravity="center_horizontal|bottom" android:layout_marginBottom="10dp" android:contentDescription="@string/ui_wow" />
        </FrameLayout>
        <FrameLayout android:layout_width="0dp" android:layout_height="92dp" android:layout_weight="1" android:id="@+id/reaction4" android:clickable="true" android:focusable="true" android:contentDescription="@string/ui_sad">
          <ImageView android:layout_width="36dp" android:layout_height="36dp" android:src="@drawable/reaction_sad" android:layout_gravity="center_horizontal|bottom" android:layout_marginBottom="10dp" android:contentDescription="@string/ui_sad" />
        </FrameLayout>
        <FrameLayout android:layout_width="0dp" android:layout_height="92dp" android:layout_weight="1" android:id="@+id/reaction5" android:clickable="true" android:focusable="true" android:contentDescription="@string/ui_angry">
          <ImageView android:layout_width="36dp" android:layout_height="36dp" android:src="@drawable/reaction_angry" android:layout_gravity="center_horizontal|bottom" android:layout_marginBottom="10dp" android:contentDescription="@string/ui_angry" />
        </FrameLayout>
      </LinearLayout>
    </FrameLayout>
  </FrameLayout>
</LinearLayout>