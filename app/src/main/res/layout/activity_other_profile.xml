      </FrameLayout>
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_omar_farooq" android:textSize="26sp" android:textColor="#252722" android:gravity="center" android:textStyle="bold" android:id="@+id/profileName" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_1_204_friends_38_mutual" android:textSize="16sp" android:textColor="#252722" android:gravity="center" android:paddingVertical="6dp" android:id="@+id/otherFriendCount" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_night_photographer_karachi_after_dark" android:textSize="16sp" android:textColor="#252722" android:gravity="center" android:id="@+id/profileBio" />
        <Space android:layout_width="match_parent" android:layout_height="12dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
          <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/ui_add_friend" android:textSize="14sp" android:textColor="#FFFFFF" android:id="@+id/btnPrimary" android:gravity="center" android:textStyle="bold" android:background="@drawable/button_teal" android:clickable="true" android:focusable="true" android:layout_weight="1" android:drawableStart="@drawable/ic_add_person" android:paddingHorizontal="12dp" android:drawableTint="#FFFFFF" android:minHeight="48dp" android:paddingVertical="8dp" android:freezesText="true" />
          <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/ui_message" android:textSize="14sp" android:textColor="#252722" android:id="@+id/btnSecondary" android:gravity="center" android:textStyle="bold" android:background="@drawable/button_pale" android:clickable="true" android:focusable="true" android:layout_weight="1" android:layout_marginStart="8dp" android:drawableStart="@drawable/ic_chat" android:paddingHorizontal="12dp" android:minHeight="48dp" android:paddingVertical="8dp" android:freezesText="true" />
          <ImageButton android:layout_width="44dp" android:layout_height="48dp" android:id="@+id/btnProfileMore" android:src="@drawable/ic_more" android:background="@android:color/transparent" android:padding="12dp" android:contentDescription="@string/ui_more" android:backgroundTint="#ECEBE6" app:tint="#0B5F63" />
        </LinearLayout>
        <Space android:layout_width="match_parent" android:layout_height="12dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
