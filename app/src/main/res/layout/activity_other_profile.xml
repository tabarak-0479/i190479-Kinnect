            <TextView android:layout_width="24dp" android:layout_height="24dp" android:text="@string/ui_ak" android:textSize="18sp" android:textColor="#FFFFFF" android:background="@drawable/circle_red" android:gravity="center" android:textStyle="bold" app:autoSizeTextType="uniform" app:autoSizeMinTextSize="6sp" app:autoSizeMaxTextSize="18sp" app:autoSizeStepGranularity="1sp" />
            <TextView android:layout_width="24dp" android:layout_height="24dp" android:text="@string/ui_lm" android:textSize="18sp" android:textColor="#FFFFFF" android:background="@drawable/circle_purple" android:gravity="center" android:textStyle="bold" android:layout_marginStart="20dp" app:autoSizeTextType="uniform" app:autoSizeMinTextSize="6sp" app:autoSizeMaxTextSize="18sp" app:autoSizeStepGranularity="1sp" />
            <TextView android:layout_width="24dp" android:layout_height="24dp" android:text="@string/ui_zr" android:textSize="18sp" android:textColor="#FFFFFF" android:background="@drawable/circle_blue" android:gravity="center" android:textStyle="bold" android:layout_marginStart="40dp" app:autoSizeTextType="uniform" app:autoSizeMinTextSize="6sp" app:autoSizeMaxTextSize="18sp" app:autoSizeStepGranularity="1sp" />
          </FrameLayout>
          <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/ui_friends_with_aisha_khan_lina_marsh_and_36_oth" android:textSize="14sp" android:textColor="#252722" android:layout_weight="1" android:paddingStart="10dp" />
        </LinearLayout>
        <Space android:layout_width="match_parent" android:layout_height="12dp" />
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#DFDFD8" />
        <Space android:layout_width="match_parent" android:layout_height="12dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="2dp" android:baselineAligned="false">
          <ImageButton android:layout_width="36dp" android:layout_height="36dp" android:id="@+id/detailwork" android:src="@drawable/ic_work" android:background="@android:color/transparent" android:padding="7dp" android:contentDescription="@string/ui_work" android:clickable="false" android:focusable="false" android:importantForAccessibility="no" app:tint="#0B5F63" />
          <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/ui_photographer_at_studio_nocturne" android:textSize="16sp" android:textColor="#252722" android:layout_weight="1" android:paddingStart="8dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="2dp" android:baselineAligned="false">
          <ImageButton android:layout_width="36dp" android:layout_height="36dp" android:id="@+id/detailpin" android:src="@drawable/ic_pin" android:background="@android:color/transparent" android:padding="7dp" android:contentDescription="@string/ui_pin" android:clickable="false" android:focusable="false" android:importantForAccessibility="no" app:tint="#0B5F63" />
          <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/ui_lives_in_karachi_pakistan" android:textSize="16sp" android:textColor="#252722" android:layout_weight="1" android:paddingStart="8dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="2dp" android:baselineAligned="false">
          <ImageButton android:layout_width="36dp" android:layout_height="36dp" android:id="@+id/detailhistory" android:src="@drawable/ic_history" android:background="@android:color/transparent" android:padding="7dp" android:contentDescription="@string/ui_history" android:clickable="false" android:focusable="false" android:importantForAccessibility="no" app:tint="#0B5F63" />
          <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/ui_joined_june_2017" android:textSize="16sp" android:textColor="#252722" android:layout_weight="1" android:paddingStart="8dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
          <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/ui_photos" android:textSize="18sp" android:textColor="#252722" android:textStyle="bold" android:padding="16dp" android:layout_weight="1" />
          <TextView android:layout_width="64dp" android:layout_height="wrap_content" android:text="@string/ui_see_all" android:textSize="14sp" android:textColor="#0B5F63" android:gravity="center" android:textStyle="bold" android:id="@+id/btnSeePhotos" android:clickable="true" android:focusable="true" android:minHeight="48dp" android:paddingVertical="8dp" android:freezesText="true" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:id="@+id/otherPhotos" android:baselineAligned="false">
          <FrameLayout android:layout_width="0dp" android:layout_height="110dp" android:layout_weight="1" android:layout_margin="2dp" android:background="@drawable/card_white" android:clipToOutline="true">
            <ImageView android:layout_width="match_parent" android:layout_height="110dp" android:src="@drawable/landscape_night" android:scaleType="centerCrop" android:contentDescription="@string/ui_landscape_illustration" />
          </FrameLayout>
          <FrameLayout android:layout_width="0dp" android:layout_height="110dp" android:layout_weight="1" android:layout_margin="2dp" android:background="@drawable/card_white" android:clipToOutline="true">
            <ImageView android:layout_width="match_parent" android:layout_height="110dp" android:src="@drawable/landscape_purple" android:scaleType="centerCrop" android:contentDescription="@string/ui_landscape_illustration" />
          </FrameLayout>
          <FrameLayout android:layout_width="0dp" android:layout_height="110dp" android:layout_weight="1" android:layout_margin="2dp" android:background="@drawable/card_white" android:clipToOutline="true">
            <ImageView android:layout_width="match_parent" android:layout_height="110dp" android:src="@drawable/landscape_blue" android:scaleType="centerCrop" android:contentDescription="@string/ui_landscape_illustration" />
          </FrameLayout>
        </LinearLayout>
      </LinearLayout>
    </LinearLayout>
  </ScrollView>
</LinearLayout>