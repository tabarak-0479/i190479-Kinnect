<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#FFFFFF">
  <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:gravity="center_vertical">
    <ImageButton android:layout_width="48dp" android:layout_height="48dp" android:id="@+id/btnBack" android:src="@drawable/ic_back" android:background="@android:color/transparent" android:padding="12dp" android:contentDescription="Back" app:tint="#0B5F63" />
    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="Omar Farooq" android:textSize="20sp" android:textColor="#252722" android:layout_weight="1" android:textStyle="bold" android:id="@+id/profileToolbarName" />
    <ImageButton android:layout_width="48dp" android:layout_height="48dp" android:id="@+id/btnSearch" android:src="@drawable/ic_search" android:background="@android:color/transparent" android:padding="12dp" android:contentDescription="Search" app:tint="#0B5F63" />
  </LinearLayout>
  <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#DFDFD8" />
  <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:fillViewport="true" android:layout_weight="1" android:id="@+id/otherProfileScroll">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
      <FrameLayout android:layout_width="match_parent" android:layout_height="266dp">
        <ImageView android:layout_width="match_parent" android:layout_height="196dp" android:id="@+id/profileCover" android:src="@drawable/cover_night" android:scaleType="centerCrop" android:contentDescription="Cover photo" />
        <FrameLayout android:layout_width="148dp" android:layout_height="148dp" android:layout_gravity="bottom|center_horizontal" android:layout_marginStart="16dp" android:background="@drawable/avatar_border">
          <TextView android:layout_width="140dp" android:layout_height="140dp" android:text="OF" android:textSize="46sp" android:textColor="#FFFFFF" android:background="@drawable/circle_green" android:gravity="center" android:textStyle="bold" android:layout_gravity="center" android:id="@+id/profileAvatar" />
          <ImageView android:layout_width="140dp" android:layout_height="140dp" android:id="@+id/profileAvatarPhoto" android:layout_gravity="center" android:scaleType="centerCrop" android:background="@drawable/circle_teal" android:clipToOutline="true" android:visibility="gone" android:contentDescription="Selected profile picture" />
        </FrameLayout>
      </FrameLayout>
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Omar Farooq" android:textSize="26sp" android:textColor="#252722" android:gravity="center" android:textStyle="bold" android:id="@+id/profileName" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="1,204 friends · 38 mutual" android:textSize="16sp" android:textColor="#252722" android:gravity="center" android:paddingVertical="6dp" android:id="@+id/otherFriendCount" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Night photographer. Karachi after dark." android:textSize="16sp" android:textColor="#252722" android:gravity="center" android:id="@+id/profileBio" />
        <Space android:layout_width="match_parent" android:layout_height="12dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
          <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="Add friend" android:textSize="14sp" android:textColor="#FFFFFF" android:id="@+id/btnPrimary" android:gravity="center" android:textStyle="bold" android:background="@drawable/button_teal" android:clickable="true" android:focusable="true" android:layout_weight="1" android:drawableStart="@drawable/ic_add_person" android:paddingHorizontal="12dp" android:drawableTint="#FFFFFF" android:minHeight="48dp" android:paddingVertical="8dp" />
          <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="Message" android:textSize="14sp" android:textColor="#252722" android:id="@+id/btnSecondary" android:gravity="center" android:textStyle="bold" android:background="@drawable/button_pale" android:clickable="true" android:focusable="true" android:layout_weight="1" android:layout_marginStart="8dp" android:drawableStart="@drawable/ic_chat" android:paddingHorizontal="12dp" android:minHeight="48dp" android:paddingVertical="8dp" />
          <ImageButton android:layout_width="44dp" android:layout_height="48dp" android:id="@+id/btnProfileMore" android:src="@drawable/ic_more" android:background="@android:color/transparent" android:padding="12dp" android:contentDescription="More" android:backgroundTint="#ECEBE6" app:tint="#0B5F63" />
        </LinearLayout>
        <Space android:layout_width="match_parent" android:layout_height="12dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
          <FrameLayout android:layout_width="66dp" android:layout_height="28dp">
            <TextView android:layout_width="24dp" android:layout_height="24dp" android:text="AK" android:textSize="18sp" android:textColor="#FFFFFF" android:background="@drawable/circle_red" android:gravity="center" android:textStyle="bold" />
            <TextView android:layout_width="24dp" android:layout_height="24dp" android:text="LM" android:textSize="18sp" android:textColor="#FFFFFF" android:background="@drawable/circle_purple" android:gravity="center" android:textStyle="bold" android:layout_marginStart="20dp" />
            <TextView android:layout_width="24dp" android:layout_height="24dp" android:text="ZR" android:textSize="18sp" android:textColor="#FFFFFF" android:background="@drawable/circle_blue" android:gravity="center" android:textStyle="bold" android:layout_marginStart="40dp" />
          </FrameLayout>
          <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="Friends with Aisha Khan, Lina Marsh and 36 others" android:textSize="14sp" android:textColor="#252722" android:layout_weight="1" android:paddingStart="10dp" />
        </LinearLayout>
        <Space android:layout_width="match_parent" android:layout_height="12dp" />
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#DFDFD8" />
        <Space android:layout_width="match_parent" android:layout_height="12dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="2dp">
          <ImageButton android:layout_width="36dp" android:layout_height="36dp" android:id="@+id/detailwork" android:src="@drawable/ic_work" android:background="@android:color/transparent" android:padding="7dp" android:contentDescription="Work" android:clickable="false" android:focusable="false" android:importantForAccessibility="no" app:tint="#0B5F63" />
          <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="Photographer at Studio Nocturne" android:textSize="16sp" android:textColor="#252722" android:layout_weight="1" android:paddingStart="8dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="2dp">
          <ImageButton android:layout_width="36dp" android:layout_height="36dp" android:id="@+id/detailpin" android:src="@drawable/ic_pin" android:background="@android:color/transparent" android:padding="7dp" android:contentDescription="Pin" android:clickable="false" android:focusable="false" android:importantForAccessibility="no" app:tint="#0B5F63" />
          <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="Lives in Karachi, Pakistan" android:textSize="16sp" android:textColor="#252722" android:layout_weight="1" android:paddingStart="8dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="2dp">
          <ImageButton android:layout_width="36dp" android:layout_height="36dp" android:id="@+id/detailhistory" android:src="@drawable/ic_history" android:background="@android:color/transparent" android:padding="7dp" android:contentDescription="History" android:clickable="false" android:focusable="false" android:importantForAccessibility="no" app:tint="#0B5F63" />
          <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="Joined June 2017" android:textSize="16sp" android:textColor="#252722" android:layout_weight="1" android:paddingStart="8dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
          <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="Photos" android:textSize="18sp" android:textColor="#252722" android:textStyle="bold" android:padding="16dp" android:layout_weight="1" />
          <TextView android:layout_width="64dp" android:layout_height="wrap_content" android:text="See all" android:textSize="14sp" android:textColor="#0B5F63" android:gravity="center" android:textStyle="bold" android:id="@+id/btnSeePhotos" android:clickable="true" android:focusable="true" android:minHeight="48dp" android:paddingVertical="8dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:id="@+id/otherPhotos">
          <FrameLayout android:layout_width="0dp" android:layout_height="110dp" android:layout_weight="1" android:layout_margin="2dp" android:background="@drawable/card_white" android:clipToOutline="true">
            <ImageView android:layout_width="match_parent" android:layout_height="110dp" android:src="@drawable/landscape_night" android:scaleType="centerCrop" android:contentDescription="Landscape illustration" />
          </FrameLayout>
          <FrameLayout android:layout_width="0dp" android:layout_height="110dp" android:layout_weight="1" android:layout_margin="2dp" android:background="@drawable/card_white" android:clipToOutline="true">
            <ImageView android:layout_width="match_parent" android:layout_height="110dp" android:src="@drawable/landscape_purple" android:scaleType="centerCrop" android:contentDescription="Landscape illustration" />
          </FrameLayout>
          <FrameLayout android:layout_width="0dp" android:layout_height="110dp" android:layout_weight="1" android:layout_margin="2dp" android:background="@drawable/card_white" android:clipToOutline="true">
            <ImageView android:layout_width="match_parent" android:layout_height="110dp" android:src="@drawable/landscape_blue" android:scaleType="centerCrop" android:contentDescription="Landscape illustration" />
          </FrameLayout>
        </LinearLayout>
      </LinearLayout>
    </LinearLayout>
  </ScrollView>
</LinearLayout>