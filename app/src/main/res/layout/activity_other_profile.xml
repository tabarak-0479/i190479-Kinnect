          <ImageView android:layout_width="140dp" android:layout_height="140dp" android:id="@+id/profileAvatarPhoto" android:layout_gravity="center" android:scaleType="centerCrop" android:background="@drawable/circle_teal" android:clipToOutline="true" android:visibility="gone" android:contentDescription="@string/ui_selected_profile_picture" />
