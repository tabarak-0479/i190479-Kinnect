<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#111111">
  <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_margin="8dp" android:background="@drawable/viewfinder" android:clipToOutline="true">
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/landscape_night" android:scaleType="centerCrop" android:contentDescription="@string/ui_landscape_illustration" android:id="@+id/storyImage" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
      <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:id="@+id/btnStoryPrevious" android:clickable="true" android:focusable="true" android:contentDescription="@string/ui_previous_story" />
      <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:id="@+id/btnStoryNext" android:clickable="true" android:focusable="true" android:contentDescription="@string/ui_next_story" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="10dp" android:paddingTop="10dp" android:baselineAligned="false">
        <View android:layout_width="0dp" android:layout_height="3dp" android:layout_weight="1" android:background="#FFFFFF" android:alpha="1" android:layout_marginEnd="4dp" android:id="@+id/storySegment0" />
        <View android:layout_width="0dp" android:layout_height="3dp" android:layout_weight="1" android:background="#FFFFFF" android:alpha="1" android:layout_marginEnd="4dp" android:id="@+id/storySegment1" />
        <View android:layout_width="0dp" android:layout_height="3dp" android:layout_weight="1" android:background="#FFFFFF" android:alpha="0.4" android:layout_marginEnd="4dp" android:id="@+id/storySegment2" />
        <View android:layout_width="0dp" android:layout_height="3dp" android:layout_weight="1" android:background="#FFFFFF" android:alpha="0.4" android:layout_marginEnd="4dp" android:id="@+id/storySegment3" />
      </LinearLayout>
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="10dp" android:baselineAligned="false">
        <TextView android:layout_width="40dp" android:layout_height="40dp" android:text="@string/ui_of" android:textSize="18sp" android:textColor="#FFFFFF" android:background="@drawable/circle_green" android:gravity="center" android:textStyle="bold" android:id="@+id/storyPersonAvatar" app:autoSizeTextType="uniform" app:autoSizeMinTextSize="6sp" app:autoSizeMaxTextSize="18sp" app:autoSizeStepGranularity="1sp" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:paddingStart="10dp">
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_omar_farooq" android:textSize="16sp" android:textColor="#FFFFFF" android:textStyle="bold" android:id="@+id/storyPerson" />
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_5h_public" android:textSize="12sp" android:textColor="#FFFFFF" android:id="@+id/storyAge" />
        </LinearLayout>
        <ImageButton android:layout_width="48dp" android:layout_height="48dp" android:id="@+id/btnOptions" android:src="@drawable/ic_more" android:background="@android:color/transparent" android:padding="12dp" android:contentDescription="@string/ui_options" app:tint="#FFFFFF" />
        <ImageButton android:layout_width="48dp" android:layout_height="48dp" android:id="@+id/btnBack" android:src="@drawable/ic_close" android:background="@android:color/transparent" android:padding="12dp" android:contentDescription="@string/ui_back" app:tint="#FFFFFF" />
      </LinearLayout>
    </LinearLayout>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_karachi_nights" android:textSize="24sp" android:textColor="#181A17" android:id="@+id/storyCaption" android:textStyle="bold" android:background="@drawable/card_white" android:padding="12dp" android:layout_gravity="center" android:rotation="-5" />
  </FrameLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="12dp" android:baselineAligned="false">
    <EditText android:layout_width="0dp" android:layout_height="wrap_content" android:id="@+id/etStoryReply" android:hint="@string/ui_send_message" android:text="" android:textSize="15sp" android:textColor="#FFFFFF" android:textColorHint="#70736D" android:paddingHorizontal="12dp" android:background="@drawable/transparent_outline" android:inputType="textCapSentences" android:layout_weight="1" android:backgroundTint="#111111" android:imeOptions="actionSend" android:minHeight="48dp" android:paddingVertical="8dp" android:importantForAutofill="no" />
    <ImageButton android:layout_width="40dp" android:layout_height="48dp" android:id="@+id/btnStoryReplySend" android:src="@drawable/ic_send" android:background="@android:color/transparent" android:padding="12dp" android:contentDescription="@string/ui_storyreplysend" android:visibility="gone" app:tint="#FFFFFF" />
    <ImageButton android:layout_width="48dp" android:layout_height="48dp" android:id="@+id/btnStoryThumb" android:src="@drawable/ic_like" android:background="@drawable/circle_teal" android:padding="12dp" android:contentDescription="@string/ui_storythumb" app:tint="#FFFFFF" />
    <ImageButton android:layout_width="48dp" android:layout_height="48dp" android:id="@+id/btnStoryLike" android:src="@drawable/ic_heart" android:background="@drawable/reaction_love" android:padding="12dp" android:contentDescription="@string/ui_storylike" app:tint="#FFFFFF" />
    <ImageButton android:layout_width="48dp" android:layout_height="48dp" android:id="@+id/btnStorySmile" android:src="@drawable/reaction_haha" android:background="@android:color/transparent" android:padding="4dp" android:contentDescription="@string/ui_storysmile" app:tint="@null" />
  </LinearLayout>
</LinearLayout>