<?xml version="1.0" ?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#FFFFFF">
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="Notifications" android:textSize="25sp" android:textColor="#252722" android:layout_weight="1" android:textStyle="bold" android:paddingStart="16dp"/>
        <ImageButton android:layout_width="48dp" android:layout_height="48dp" android:id="@+id/btnSearch" android:src="@drawable/ic_search" android:background="?attr/selectableItemBackgroundBorderless" android:padding="12dp" android:contentDescription="Search"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
            <ImageButton android:layout_width="match_parent" android:layout_height="48dp" android:id="@+id/navHome" android:src="@drawable/ic_home" android:background="?attr/selectableItemBackgroundBorderless" android:padding="12dp" android:contentDescription="Home"/>
            <View android:layout_width="match_parent" android:layout_height="3dp" android:background="#FFFFFF"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
            <ImageButton android:layout_width="match_parent" android:layout_height="48dp" android:id="@+id/navPeople" android:src="@drawable/ic_people" android:background="?attr/selectableItemBackgroundBorderless" android:padding="12dp" android:contentDescription="People"/>
            <View android:layout_width="match_parent" android:layout_height="3dp" android:background="#FFFFFF"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
            <ImageButton android:layout_width="match_parent" android:layout_height="48dp" android:id="@+id/navMarketplace" android:src="@drawable/ic_marketplace" android:background="?attr/selectableItemBackgroundBorderless" android:padding="12dp" android:contentDescription="Marketplace"/>
            <View android:layout_width="match_parent" android:layout_height="3dp" android:background="#FFFFFF"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
            <ImageButton android:layout_width="match_parent" android:layout_height="48dp" android:id="@+id/navNotifications" android:src="@drawable/ic_notifications" android:background="?attr/selectableItemBackgroundBorderless" android:padding="12dp" android:contentDescription="Notifications"/>
            <View android:layout_width="match_parent" android:layout_height="3dp" android:background="#0B5F63"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
            <ImageButton android:layout_width="match_parent" android:layout_height="48dp" android:id="@+id/navMenu" android:src="@drawable/ic_menu" android:background="?attr/selectableItemBackgroundBorderless" android:padding="12dp" android:contentDescription="Menu"/>
            <View android:layout_width="match_parent" android:layout_height="3dp" android:background="#FFFFFF"/>
        </LinearLayout>
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#DFDFD8"/>
    <ScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="New" android:textSize="18sp" android:textColor="#252722" android:textStyle="bold" android:padding="16dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp" android:background="#E3EFF0" android:id="@+id/notice0" android:clickable="true" android:focusable="true">
                <TextView android:layout_width="56dp" android:layout_height="56dp" android:text="AK" android:textSize="18sp" android:textColor="#FFFFFF" android:background="@drawable/circle_red" android:gravity="center" android:textStyle="bold"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:paddingStart="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Aisha Khan and 32 others reacted to your photo.
5m" android:textSize="14sp" android:textColor="#252722"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="•••" android:textSize="14sp" android:textColor="#252722"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp" android:background="#E3EFF0" android:id="@+id/notice1" android:clickable="true" android:focusable="true">
                <TextView android:layout_width="56dp" android:layout_height="56dp" android:text="SI" android:textSize="18sp" android:textColor="#FFFFFF" android:background="@drawable/circle_blue" android:gravity="center" android:textStyle="bold"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:paddingStart="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sara Iqbal sent you a friend request.
20m" android:textSize="14sp" android:textColor="#252722"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_height="48dp" android:text="Confirm" android:textSize="14sp" android:textColor="#FFFFFF" android:id="@+id/btnConfirmNotice" android:gravity="center" android:textStyle="bold" android:background="@drawable/button_teal" android:clickable="true" android:focusable="true" android:layout_weight="1"/>
                        <TextView android:layout_width="0dp" android:layout_height="48dp" android:text="Delete" android:textSize="14sp" android:textColor="#252722" android:id="@+id/btnDeleteNotice" android:gravity="center" android:textStyle="bold" android:background="@drawable/button_pale" android:clickable="true" android:focusable="true" android:layout_weight="1" android:layout_marginStart="8dp"/>
                    </LinearLayout>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="•••" android:textSize="14sp" android:textColor="#252722"/>
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Earlier" android:textSize="18sp" android:textColor="#252722" android:textStyle="bold" android:padding="16dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp" android:background="#FFFFFF" android:id="@+id/notice2" android:clickable="true" android:focusable="true">
                <TextView android:layout_width="56dp" android:layout_height="56dp" android:text="ZR" android:textSize="18sp" android:textColor="#FFFFFF" android:background="@drawable/circle_blue" android:gravity="center" android:textStyle="bold"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:paddingStart="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Zain Raza replied to your comment:
“next time invite the rest of us”
2h" android:textSize="14sp" android:textColor="#252722"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="•••" android:textSize="14sp" android:textColor="#252722"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp" android:background="#FFFFFF" android:id="@+id/notice3" android:clickable="true" android:focusable="true">
                <TextView android:layout_width="56dp" android:layout_height="56dp" android:text="DC" android:textSize="18sp" android:textColor="#FFFFFF" android:background="@drawable/circle_gold" android:gravity="center" android:textStyle="bold"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:paddingStart="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="New post in SMD Class of 2026:
“Assignment 1 is out. Start early.”
5h" android:textSize="14sp" android:textColor="#252722"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="•••" android:textSize="14sp" android:textColor="#252722"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp" android:background="#FFFFFF" android:id="@+id/notice4" android:clickable="true" android:focusable="true">
                <TextView android:layout_width="56dp" android:layout_height="56dp" android:text="HA" android:textSize="18sp" android:textColor="#FFFFFF" android:background="@drawable/circle_gold" android:gravity="center" android:textStyle="bold"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:paddingStart="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hamza Ali tagged you in a post.
Yesterday" android:textSize="14sp" android:textColor="#252722"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="•••" android:textSize="14sp" android:textColor="#252722"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp" android:background="#FFFFFF" android:id="@+id/notice5" android:clickable="true" android:focusable="true">
                <TextView android:layout_width="56dp" android:layout_height="56dp" android:text="LM" android:textSize="18sp" android:textColor="#FFFFFF" android:background="@drawable/circle_purple" android:gravity="center" android:textStyle="bold"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:paddingStart="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Lina Marsh liked your story.
2d" android:textSize="14sp" android:textColor="#252722"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="•••" android:textSize="14sp" android:textColor="#252722"/>
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="48dp" android:text="See previous notifications" android:textSize="14sp" android:textColor="#252722" android:id="@+id/btnPrevious" android:gravity="center" android:textStyle="bold" android:background="@drawable/button_pale" android:clickable="true" android:focusable="true"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
