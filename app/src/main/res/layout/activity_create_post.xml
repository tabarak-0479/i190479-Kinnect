<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#FFFFFF">
  <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingEnd="12dp">
    <ImageButton android:layout_width="48dp" android:layout_height="48dp" android:id="@+id/btnBack" android:src="@drawable/ic_back" android:background="?attr/selectableItemBackgroundBorderless" android:padding="12dp" android:contentDescription="Back" app:tint="#0B5F63" />
    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="Create post" android:textSize="20sp" android:textColor="#252722" android:layout_weight="1" android:textStyle="bold" />
    <TextView android:layout_width="wrap_content" android:layout_height="48dp" android:text="Post" android:textSize="14sp" android:textColor="#252722" android:id="@+id/btnPost" android:gravity="center" android:textStyle="bold" android:background="@drawable/button_pale" android:clickable="true" android:focusable="true" android:paddingHorizontal="14dp" />
  </LinearLayout>
  <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#DFDFD8" />
  <ScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp">
        <TextView android:layout_width="44dp" android:layout_height="44dp" android:text="JW" android:textSize="18sp" android:textColor="#FFFFFF" android:background="@drawable/circle_teal" android:gravity="center" android:textStyle="bold" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="12dp">
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Jacob West" android:textSize="14sp" android:textColor="#252722" android:textStyle="bold" />
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="◉ Public  ⌄     + Album  ⌄" android:textSize="14sp" android:textColor="#0B5F63" />
        </LinearLayout>
      </LinearLayout>
      <EditText android:layout_width="match_parent" android:layout_height="132dp" android:id="@+id/etPost" android:hint="What’s on your mind?" android:text="Weekend plan: coffee, sketching, and absolutely no email." android:textSize="23sp" android:textColor="#252722" android:textColorHint="#70736D" android:paddingHorizontal="12dp" android:background="@drawable/button_pale" android:inputType="textCapSentences|textMultiLine" android:gravity="top" android:backgroundTint="#FFFFFF" />
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="12dp">
        <TextView android:layout_width="0dp" android:layout_height="36dp" android:text="Aa" android:textSize="14sp" android:textColor="#252722" android:layout_weight="1" android:background="@drawable/palette0" android:layout_margin="3dp" android:gravity="center" android:id="@+id/color0" android:clickable="true" android:focusable="true" android:contentDescription="Post background 0" />
        <TextView android:layout_width="0dp" android:layout_height="36dp" android:text="" android:textSize="14sp" android:textColor="#252722" android:layout_weight="1" android:background="@drawable/palette1" android:layout_margin="3dp" android:gravity="center" android:id="@+id/color1" android:clickable="true" android:focusable="true" android:contentDescription="Post background 1" />
        <TextView android:layout_width="0dp" android:layout_height="36dp" android:text="" android:textSize="14sp" android:textColor="#252722" android:layout_weight="1" android:background="@drawable/palette2" android:layout_margin="3dp" android:gravity="center" android:id="@+id/color2" android:clickable="true" android:focusable="true" android:contentDescription="Post background 2" />
        <TextView android:layout_width="0dp" android:layout_height="36dp" android:text="" android:textSize="14sp" android:textColor="#252722" android:layout_weight="1" android:background="@drawable/palette3" android:layout_margin="3dp" android:gravity="center" android:id="@+id/color3" android:clickable="true" android:focusable="true" android:contentDescription="Post background 3" />
        <TextView android:layout_width="0dp" android:layout_height="36dp" android:text="" android:textSize="14sp" android:textColor="#252722" android:layout_weight="1" android:background="@drawable/palette4" android:layout_margin="3dp" android:gravity="center" android:id="@+id/color4" android:clickable="true" android:focusable="true" android:contentDescription="Post background 4" />
        <TextView android:layout_width="0dp" android:layout_height="36dp" android:text="" android:textSize="14sp" android:textColor="#252722" android:layout_weight="1" android:background="@drawable/palette5" android:layout_margin="3dp" android:gravity="center" android:id="@+id/color5" android:clickable="true" android:focusable="true" android:contentDescription="Post background 5" />
        <TextView android:layout_width="0dp" android:layout_height="36dp" android:text="" android:textSize="14sp" android:textColor="#252722" android:layout_weight="1" android:background="@drawable/palette6" android:layout_margin="3dp" android:gravity="center" android:id="@+id/color6" android:clickable="true" android:focusable="true" android:contentDescription="Post background 6" />
        <TextView android:layout_width="0dp" android:layout_height="36dp" android:text="" android:textSize="14sp" android:textColor="#252722" android:layout_weight="1" android:background="@drawable/palette7" android:layout_margin="3dp" android:gravity="center" android:id="@+id/color7" android:clickable="true" android:focusable="true" android:contentDescription="Post background 7" />
      </LinearLayout>
      <Space android:layout_width="match_parent" android:layout_height="80dp" />
      <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#DFDFD8" />
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="━━━━" android:textSize="14sp" android:textColor="#CCCBC2" android:gravity="center" />
      <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:gravity="center_vertical" android:id="@+id/btnPhoto" android:clickable="true" android:focusable="true" android:paddingHorizontal="12dp">
        <ImageButton android:layout_width="48dp" android:layout_height="48dp" android:id="@+id/btnPhotoIcon" android:src="@drawable/ic_image" android:background="?attr/selectableItemBackgroundBorderless" android:padding="12dp" android:contentDescription="Image" app:tint="#0B5F63" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="Photo/video" android:textSize="17sp" android:textColor="#252722" android:layout_weight="1" />
      </LinearLayout>
      <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:gravity="center_vertical" android:id="@+id/btnTag" android:clickable="true" android:focusable="true" android:paddingHorizontal="12dp">
        <ImageButton android:layout_width="48dp" android:layout_height="48dp" android:id="@+id/btnTagIcon" android:src="@drawable/ic_people" android:background="?attr/selectableItemBackgroundBorderless" android:padding="12dp" android:contentDescription="People" app:tint="#0B5F63" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="Tag people" android:textSize="17sp" android:textColor="#252722" android:layout_weight="1" />
      </LinearLayout>
      <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:gravity="center_vertical" android:id="@+id/btnFeeling" android:clickable="true" android:focusable="true" android:paddingHorizontal="12dp">
        <ImageButton android:layout_width="48dp" android:layout_height="48dp" android:id="@+id/btnFeelingIcon" android:src="@drawable/ic_like" android:background="?attr/selectableItemBackgroundBorderless" android:padding="12dp" android:contentDescription="Like" app:tint="#0B5F63" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="Feeling/activity" android:textSize="17sp" android:textColor="#252722" android:layout_weight="1" />
      </LinearLayout>
      <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:gravity="center_vertical" android:id="@+id/btnCheckin" android:clickable="true" android:focusable="true" android:paddingHorizontal="12dp">
        <ImageButton android:layout_width="48dp" android:layout_height="48dp" android:id="@+id/btnCheckinIcon" android:src="@drawable/ic_share" android:background="?attr/selectableItemBackgroundBorderless" android:padding="12dp" android:contentDescription="Share" app:tint="#0B5F63" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="Check in" android:textSize="17sp" android:textColor="#252722" android:layout_weight="1" />
      </LinearLayout>
      <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:gravity="center_vertical" android:id="@+id/btnLive" android:clickable="true" android:focusable="true" android:paddingHorizontal="12dp">
        <ImageButton android:layout_width="48dp" android:layout_height="48dp" android:id="@+id/btnLiveIcon" android:src="@drawable/ic_chat" android:background="?attr/selectableItemBackgroundBorderless" android:padding="12dp" android:contentDescription="Chat" app:tint="#0B5F63" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="Live video" android:textSize="17sp" android:textColor="#252722" android:layout_weight="1" />
      </LinearLayout>
      <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:gravity="center_vertical" android:id="@+id/btnCamera" android:clickable="true" android:focusable="true" android:paddingHorizontal="12dp">
        <ImageButton android:layout_width="48dp" android:layout_height="48dp" android:id="@+id/btnCameraIcon" android:src="@drawable/ic_camera" android:background="?attr/selectableItemBackgroundBorderless" android:padding="12dp" android:contentDescription="Camera" app:tint="#0B5F63" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="Camera" android:textSize="17sp" android:textColor="#252722" android:layout_weight="1" />
      </LinearLayout>
      <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:gravity="center_vertical" android:id="@+id/btnEvent" android:clickable="true" android:focusable="true" android:paddingHorizontal="12dp">
        <ImageButton android:layout_width="48dp" android:layout_height="48dp" android:id="@+id/btnEventIcon" android:src="@drawable/ic_add" android:background="?attr/selectableItemBackgroundBorderless" android:padding="12dp" android:contentDescription="Add" app:tint="#0B5F63" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="Create event" android:textSize="17sp" android:textColor="#252722" android:layout_weight="1" />
      </LinearLayout>
    </LinearLayout>
  </ScrollView>
</LinearLayout>