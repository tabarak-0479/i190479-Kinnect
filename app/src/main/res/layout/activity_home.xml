<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="#FFFFFF">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
      <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="kinnect" android:textColor="#0B5F63" android:textSize="28sp" android:layout_weight="1" android:textStyle="bold" android:padding="16dp" />
      <ImageButton android:id="@+id/btnSearch" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_search" android:background="@drawable/pale" android:padding="12dp" android:contentDescription="Search" app:tint="#0B5F63" />
      <FrameLayout android:layout_width="48dp" android:layout_height="48dp">
        <ImageButton android:id="@+id/btnChats" android:layout_width="match_parent" android:layout_height="48dp" android:src="@drawable/ic_chat" android:background="@drawable/pale" android:padding="12dp" android:contentDescription="Chat" app:tint="#0B5F63" />
        <TextView android:layout_width="16dp" android:layout_height="16dp" android:text="3" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="10sp" android:gravity="center" android:background="@drawable/circle_red" android:layout_gravity="top|end" android:layout_marginEnd="8dp" android:contentDescription="3 unread chats" />
      </FrameLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
      <ImageButton android:id="@+id/navHome" android:layout_width="0dp" android:layout_height="48dp" android:src="@drawable/ic_home" android:background="?attr/selectableItemBackgroundBorderless" android:padding="12dp" android:contentDescription="Home" android:layout_weight="1" app:tint="#0B5F63" />
      <ImageButton android:id="@+id/navPeople" android:layout_width="0dp" android:layout_height="48dp" android:src="@drawable/ic_people" android:background="?attr/selectableItemBackgroundBorderless" android:padding="12dp" android:contentDescription="People" android:layout_weight="1" app:tint="#62655F" />
      <ImageButton android:id="@+id/navMarketplace" android:layout_width="0dp" android:layout_height="48dp" android:src="@drawable/ic_marketplace" android:background="?attr/selectableItemBackgroundBorderless" android:padding="12dp" android:contentDescription="Marketplace" android:layout_weight="1" app:tint="#62655F" />
      <FrameLayout android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1">
        <ImageButton android:id="@+id/navNotifications" android:layout_width="match_parent" android:layout_height="48dp" android:src="@drawable/ic_notifications" android:background="?attr/selectableItemBackgroundBorderless" android:padding="12dp" android:contentDescription="Notifications" app:tint="#62655F" />
        <TextView android:layout_width="16dp" android:layout_height="16dp" android:text="5" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="10sp" android:gravity="center" android:background="@drawable/circle_red" android:layout_gravity="top|end" android:layout_marginEnd="8dp" android:contentDescription="5 notifications" />
      </FrameLayout>
      <ImageButton android:id="@+id/navMenu" android:layout_width="0dp" android:layout_height="48dp" android:src="@drawable/ic_menu" android:background="?attr/selectableItemBackgroundBorderless" android:padding="12dp" android:contentDescription="Menu" android:layout_weight="1" app:tint="#62655F" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="3dp" android:orientation="horizontal">
      <View android:layout_width="0dp" android:layout_height="3dp" android:layout_weight="1" android:background="#0B5F63" />
      <View android:layout_width="0dp" android:layout_height="3dp" android:layout_weight="1" android:background="#FFFFFF" />
      <View android:layout_width="0dp" android:layout_height="3dp" android:layout_weight="1" android:background="#FFFFFF" />
      <View android:layout_width="0dp" android:layout_height="3dp" android:layout_weight="1" android:background="#FFFFFF" />
      <View android:layout_width="0dp" android:layout_height="3dp" android:layout_weight="1" android:background="#FFFFFF" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E6E4DC" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp">
      <TextView android:layout_width="40dp" android:layout_height="40dp" android:id="@+id/btnOwnProfile" android:clickable="true" android:focusable="true" android:text="JW" android:textSize="14sp" android:background="@drawable/circle_teal" android:gravity="center" android:textStyle="bold" android:textColor="#FFFFFF" />
      <TextView android:layout_width="0dp" android:layout_height="44dp" android:text="What’s on your mind, Jacob?" android:textColor="#242722" android:textSize="14sp" android:id="@+id/btnCreatePost" android:layout_weight="1" android:gravity="center_vertical" android:paddingHorizontal="12dp" android:layout_marginStart="10dp" android:background="@drawable/rounded_white" />
      <ImageButton android:id="@+id/btnPhoto" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_image" android:background="?attr/selectableItemBackgroundBorderless" android:padding="12dp" android:contentDescription="Image" app:tint="#0B5F63" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="8dp" android:background="#E6E4DC" />
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="200dp" android:scrollbars="none">
      <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:padding="12dp" android:orientation="horizontal">
        <FrameLayout android:id="@+id/btnCreateStory" android:layout_width="104dp" android:layout_height="176dp" android:layout_marginEnd="8dp" android:background="#E3EFF0">
          <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
            <TextView android:layout_width="64dp" android:layout_height="64dp" android:text="JW" android:textSize="24sp" android:textColor="#FFFFFF" android:background="@drawable/circle_teal" android:gravity="center" android:textStyle="bold" android:layout_gravity="top|center_horizontal" android:layout_marginTop="30dp" />
            <TextView android:layout_width="match_parent" android:layout_height="50dp" android:text="Create story" android:textSize="14sp" android:textColor="#252722" android:layout_gravity="bottom" android:gravity="bottom|center_horizontal" android:paddingBottom="10dp" android:textStyle="bold" android:background="#FFFFFF" />
            <TextView android:layout_width="36dp" android:layout_height="36dp" android:text="+" android:textSize="26sp" android:textColor="#FFFFFF" android:background="@drawable/circle_teal" android:gravity="center" android:textStyle="bold" android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="38dp" />
          </FrameLayout>
        </FrameLayout>
        <FrameLayout android:id="@+id/btnStory" android:layout_width="104dp" android:layout_height="176dp" android:layout_marginEnd="8dp">
          <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/landscape_night" android:scaleType="centerCrop" android:contentDescription="Illustrated landscape" />
          <TextView android:layout_margin="6dp" android:layout_width="38dp" android:layout_height="38dp" android:text="OF" android:textSize="14sp" android:background="@drawable/circle_teal" android:gravity="center" android:textStyle="bold" android:textColor="#FFFFFF" />
          <TextView android:layout_width="match_parent" android:layout_height="44dp" android:text="Omar Farooq" android:textColor="#242722" android:textSize="14sp" android:layout_gravity="bottom" android:gravity="center" android:textStyle="bold" android:background="#CCFFFFFF" />
        </FrameLayout>
        <FrameLayout android:id="@+id/btnStorySara" android:layout_width="104dp" android:layout_height="176dp" android:layout_marginEnd="8dp">
          <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/landscape_pink" android:scaleType="centerCrop" android:contentDescription="Illustrated landscape" />
          <TextView android:layout_margin="6dp" android:layout_width="38dp" android:layout_height="38dp" android:text="SI" android:textSize="14sp" android:background="@drawable/circle_teal" android:gravity="center" android:textStyle="bold" android:textColor="#FFFFFF" />
          <TextView android:layout_width="match_parent" android:layout_height="44dp" android:text="Sara Iqbal" android:textColor="#242722" android:textSize="14sp" android:layout_gravity="bottom" android:gravity="center" android:textStyle="bold" android:background="#CCFFFFFF" />
        </FrameLayout>
        <FrameLayout android:id="@+id/btnStoryHamza" android:layout_width="104dp" android:layout_height="176dp" android:layout_marginEnd="8dp">
          <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/landscape_green" android:scaleType="centerCrop" android:contentDescription="Illustrated landscape" />
          <TextView android:layout_margin="6dp" android:layout_width="38dp" android:layout_height="38dp" android:text="HA" android:textSize="14sp" android:background="@drawable/circle_teal" android:gravity="center" android:textStyle="bold" android:textColor="#FFFFFF" />
          <TextView android:layout_width="match_parent" android:layout_height="44dp" android:text="Hamza Ali" android:textColor="#242722" android:textSize="14sp" android:layout_gravity="bottom" android:gravity="center" android:textStyle="bold" android:background="#CCFFFFFF" />
        </FrameLayout>
      </LinearLayout>
    </HorizontalScrollView>
    <View android:layout_width="match_parent" android:layout_height="8dp" android:background="#E6E4DC" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp">
      <TextView android:layout_width="40dp" android:layout_height="40dp" android:text="LM" android:textSize="14sp" android:background="@drawable/circle_purple" android:gravity="center" android:textStyle="bold" android:textColor="#FFFFFF" />
      <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="Lina Marsh is at Clifton Beach\n2h · Public" android:textColor="#242722" android:textSize="14sp" android:layout_weight="1" android:paddingStart="10dp" android:textStyle="bold" />
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="•••    ×" android:textColor="#242722" android:textSize="14sp" />
    </LinearLayout>
    <TextView android:id="@+id/publishedPost" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:textColor="#252722" android:padding="16dp" android:visibility="gone" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Sunset walk with the crew. Worth every grain of sand in my shoes." android:textColor="#242722" android:textSize="14sp" android:paddingHorizontal="16dp" android:paddingBottom="12dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
      <ImageView android:layout_width="0dp" android:layout_height="260dp" android:src="@drawable/landscape_sand" android:scaleType="centerCrop" android:contentDescription="Illustrated landscape" android:layout_weight="1" />
      <LinearLayout android:layout_width="0dp" android:layout_height="260dp" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="2dp">
        <ImageView android:layout_width="match_parent" android:layout_height="128dp" android:src="@drawable/landscape_sea" android:scaleType="centerCrop" android:contentDescription="Illustrated landscape" />
        <FrameLayout android:layout_width="match_parent" android:layout_height="130dp" android:layout_marginTop="2dp">
          <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/landscape_pink" android:scaleType="centerCrop" android:contentDescription="Illustrated landscape" android:layout_marginTop="2dp" />
          <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="+4" android:gravity="center" android:textSize="32sp" android:textStyle="bold" android:textColor="#FFFFFF" android:background="#55332244" />
        </FrameLayout>
      </LinearLayout>
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Aisha and 1.2K others    86 comments · 12 shares" android:textColor="#242722" android:textSize="12sp" android:padding="12dp" />
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E6E4DC" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
      <ImageButton android:id="@+id/btnLike" android:layout_width="0dp" android:layout_height="48dp" android:src="@drawable/ic_like" android:background="?attr/selectableItemBackgroundBorderless" android:padding="12dp" android:contentDescription="Like" android:layout_weight="1" app:tint="#0B5F63" />
      <ImageButton android:id="@+id/btnComments" android:layout_width="0dp" android:layout_height="48dp" android:src="@drawable/ic_comment" android:background="?attr/selectableItemBackgroundBorderless" android:padding="12dp" android:contentDescription="Comment" android:layout_weight="1" app:tint="#0B5F63" />
      <ImageButton android:id="@+id/btnShare" android:layout_width="0dp" android:layout_height="48dp" android:src="@drawable/ic_share" android:background="?attr/selectableItemBackgroundBorderless" android:padding="12dp" android:contentDescription="Share" android:layout_weight="1" app:tint="#0B5F63" />
    </LinearLayout>
  </LinearLayout>
</ScrollView>