            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#DFDFD8" />
          </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="4dp">
          <TextView android:layout_width="100dp" android:layout_height="wrap_content" android:text="Username" android:textSize="16sp" android:textColor="#252722" android:labelFor="@id/etUsername" />
          <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
            <EditText android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/etUsername" android:hint="Username" android:text="jacob.west" android:textSize="15sp" android:textColor="#252722" android:textColorHint="#70736D" android:paddingHorizontal="12dp" android:background="@android:color/transparent" android:inputType="text" android:minHeight="48dp" android:paddingVertical="8dp" android:importantForAutofill="no" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#DFDFD8" />
          </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="4dp">
          <TextView android:layout_width="100dp" android:layout_height="wrap_content" android:text="Website" android:textSize="16sp" android:textColor="#252722" android:labelFor="@id/etWebsite" />
          <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
            <EditText android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/etWebsite" android:hint="Website" android:text="" android:textSize="15sp" android:textColor="#252722" android:textColorHint="#70736D" android:paddingHorizontal="12dp" android:background="@android:color/transparent" android:inputType="textUri" android:minHeight="48dp" android:paddingVertical="8dp" android:importantForAutofill="no" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#DFDFD8" />
          </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="4dp">
          <TextView android:layout_width="100dp" android:layout_height="wrap_content" android:text="Bio" android:textSize="16sp" android:textColor="#252722" android:labelFor="@id/etBio" />
          <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
            <EditText android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/etBio" android:hint="Bio" android:text="Digital goodies designer." android:textSize="15sp" android:textColor="#252722" android:textColorHint="#70736D" android:paddingHorizontal="12dp" android:background="@android:color/transparent" android:inputType="textCapSentences|textMultiLine" android:minHeight="48dp" android:paddingVertical="8dp" android:importantForAutofill="no" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#DFDFD8" />
          </LinearLayout>
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Switch to professional mode" android:textSize="14sp" android:textColor="#0B5F63" android:textStyle="bold" android:paddingVertical="16dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Private information" android:textSize="18sp" android:textColor="#252722" android:textStyle="bold" android:padding="16dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="4dp">
          <TextView android:layout_width="100dp" android:layout_height="wrap_content" android:text="Email" android:textSize="16sp" android:textColor="#252722" android:labelFor="@id/etEmail" />
          <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
            <EditText android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/etEmail" android:hint="Email" android:text="jacob.west@mail.com" android:textSize="15sp" android:textColor="#252722" android:textColorHint="#70736D" android:paddingHorizontal="12dp" android:background="@android:color/transparent" android:inputType="textEmailAddress" android:minHeight="48dp" android:paddingVertical="8dp" android:importantForAutofill="no" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#DFDFD8" />
          </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="4dp">
          <TextView android:layout_width="100dp" android:layout_height="wrap_content" android:text="Phone" android:textSize="16sp" android:textColor="#252722" android:labelFor="@id/etPhone" />
          <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
            <EditText android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/etPhone" android:hint="Phone" android:text="+92 300 1234567" android:textSize="15sp" android:textColor="#252722" android:textColorHint="#70736D" android:paddingHorizontal="12dp" android:background="@android:color/transparent" android:inputType="phone" android:minHeight="48dp" android:paddingVertical="8dp" android:importantForAutofill="no" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#DFDFD8" />
          </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="4dp">
          <TextView android:layout_width="100dp" android:layout_height="wrap_content" android:text="Gender" android:textSize="16sp" android:textColor="#252722" android:labelFor="@id/etGender" />
          <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
            <EditText android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/etGender" android:hint="Gender" android:text="Male" android:textSize="15sp" android:textColor="#252722" android:textColorHint="#70736D" android:paddingHorizontal="12dp" android:background="@android:color/transparent" android:inputType="text" android:minHeight="48dp" android:paddingVertical="8dp" android:importantForAutofill="no" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#DFDFD8" />
          </LinearLayout>
