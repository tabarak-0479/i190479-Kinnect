<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background" android:fillViewport="true">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:baselineAligned="false">
      <ImageButton android:id="@+id/btnBack" android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:textColor="@color/black" android:textSize="30sp" android:src="@drawable/ic_back" android:background="@android:color/transparent" android:contentDescription="@string/ui_back" android:padding="12dp" app:tint="#252722" />
      <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/ui_create_account" android:textColor="@color/black" android:textSize="20sp" android:textStyle="bold" />
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_step_2_of_3" android:textColor="@color/gray" android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="4dp" android:orientation="horizontal" android:baselineAligned="false">
      <View android:layout_width="0dp" android:layout_height="4dp" android:layout_weight="1" android:layout_marginEnd="6dp" android:background="@drawable/progress_teal" />
      <View android:layout_width="0dp" android:layout_height="4dp" android:layout_weight="1" android:layout_marginEnd="6dp" android:background="@drawable/progress_teal" />
      <View android:layout_width="0dp" android:layout_height="4dp" android:layout_weight="1" android:layout_marginEnd="0dp" android:background="@drawable/progress_pale" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center_vertical" android:orientation="horizontal" android:baselineAligned="false">
      <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/ui_whats_your_name_and_nbirthday" android:textColor="@color/black" android:textSize="25sp" android:textStyle="bold" />
      <FrameLayout android:layout_width="82dp" android:layout_height="82dp">
        <ImageView android:layout_width="68dp" android:layout_height="68dp" android:layout_gravity="center" android:background="@drawable/profile_dashed_circle" android:padding="18dp" android:src="@drawable/ic_person_outline" android:contentDescription="@string/ui_profile_picture" android:id="@+id/signupPerson" app:tint="#62655F" />
        <ImageView android:id="@+id/signupAvatarPhoto" android:layout_width="68dp" android:layout_height="68dp" android:layout_gravity="center" android:background="@drawable/circle_teal" android:clipToOutline="true" android:scaleType="centerCrop" android:visibility="gone" android:contentDescription="@string/ui_selected_profile_photo" />
        <ImageView android:layout_width="30dp" android:layout_height="30dp" android:layout_gravity="bottom|end" android:background="@drawable/camera_circle" android:padding="7dp" android:src="@drawable/ic_camera" android:contentDescription="@string/ui_add_profile_photo" android:id="@+id/btnSignupPhoto" android:clickable="true" android:focusable="true" app:tint="#62655F" />
      </FrameLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="horizontal" android:baselineAligned="false">
      <FrameLayout android:layout_width="0dp" android:layout_height="56dp" android:background="@drawable/rounded_white" android:layout_weight="1">
        <EditText android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent" android:hint="@string/ui_first_name" android:paddingHorizontal="14dp" android:text="@string/ui_jacob" android:textColor="@color/dark_gray" android:textColorHint="@color/gray" android:textSize="16sp" android:id="@+id/etFirstName" android:inputType="textPersonName" android:minHeight="48dp" android:paddingVertical="8dp" android:importantForAutofill="no" android:paddingTop="18dp" android:paddingBottom="2dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="16dp" android:layout_marginStart="14dp" android:layout_marginTop="6dp" android:text="@string/ui_first_name" android:textSize="12sp" android:textColor="#62655F" android:labelFor="@id/etFirstName" android:importantForAccessibility="no" />
      </FrameLayout>
      <Space android:layout_width="10dp" android:layout_height="1dp" />
      <FrameLayout android:layout_width="0dp" android:layout_height="56dp" android:background="@drawable/rounded_white" android:layout_weight="1">
        <EditText android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent" android:hint="@string/ui_last_name" android:paddingHorizontal="14dp" android:text="@string/ui_west" android:textColor="@color/dark_gray" android:textColorHint="@color/gray" android:textSize="16sp" android:id="@+id/etLastName" android:inputType="textPersonName" android:minHeight="48dp" android:paddingVertical="8dp" android:importantForAutofill="no" android:paddingTop="18dp" android:paddingBottom="2dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="16dp" android:layout_marginStart="14dp" android:layout_marginTop="6dp" android:text="@string/ui_last_name" android:textSize="12sp" android:textColor="#62655F" android:labelFor="@id/etLastName" android:importantForAccessibility="no" />
      </FrameLayout>
    </LinearLayout>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/ui_birthday" android:textColor="@color/dark_gray" android:textSize="13sp" android:textStyle="bold" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal" android:minHeight="48dp" android:baselineAligned="false">
      <FrameLayout android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:background="@drawable/rounded_white">
        <Spinner android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent" android:gravity="center_vertical" android:paddingHorizontal="14dp" android:textColor="@color/dark_gray" android:textSize="13sp" android:entries="@array/birthdayDay" android:id="@+id/birthdayDay" android:contentDescription="@string/ui_day" android:paddingTop="12dp" android:paddingEnd="18dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="14dp" android:layout_marginStart="12dp" android:layout_marginTop="4dp" android:text="@string/ui_day" android:textSize="10sp" android:textColor="#777A73" android:labelFor="@id/birthdayDay" />
        <ImageView android:layout_width="14dp" android:layout_height="14dp" android:layout_gravity="end|center_vertical" android:layout_marginEnd="8dp" android:src="@drawable/ic_chevron_down" android:importantForAccessibility="no" app:tint="#62655F" />
      </FrameLayout>
      <Space android:layout_width="8dp" android:layout_height="1dp" />
      <FrameLayout android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:background="@drawable/rounded_white">
        <Spinner android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent" android:gravity="center_vertical" android:paddingHorizontal="14dp" android:textColor="@color/dark_gray" android:textSize="13sp" android:entries="@array/birthdayMonth" android:id="@+id/birthdayMonth" android:contentDescription="@string/ui_month" android:paddingTop="12dp" android:paddingEnd="18dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="14dp" android:layout_marginStart="12dp" android:layout_marginTop="4dp" android:text="@string/ui_month" android:textSize="10sp" android:textColor="#777A73" android:labelFor="@id/birthdayMonth" />
        <ImageView android:layout_width="14dp" android:layout_height="14dp" android:layout_gravity="end|center_vertical" android:layout_marginEnd="8dp" android:src="@drawable/ic_chevron_down" android:importantForAccessibility="no" app:tint="#62655F" />
      </FrameLayout>
      <Space android:layout_width="8dp" android:layout_height="1dp" />
      <FrameLayout android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:background="@drawable/rounded_white">
        <Spinner android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent" android:gravity="center_vertical" android:paddingHorizontal="14dp" android:textColor="@color/dark_gray" android:textSize="13sp" android:entries="@array/birthdayYear" android:id="@+id/birthdayYear" android:contentDescription="@string/ui_year" android:paddingTop="12dp" android:paddingEnd="18dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="14dp" android:layout_marginStart="12dp" android:layout_marginTop="4dp" android:text="@string/ui_year" android:textSize="10sp" android:textColor="#777A73" android:labelFor="@id/birthdayYear" />
        <ImageView android:layout_width="14dp" android:layout_height="14dp" android:layout_gravity="end|center_vertical" android:layout_marginEnd="8dp" android:src="@drawable/ic_chevron_down" android:importantForAccessibility="no" app:tint="#62655F" />
      </FrameLayout>
    </LinearLayout>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/ui_gender" android:textColor="@color/dark_gray" android:textSize="13sp" android:textStyle="bold" />
    <RadioGroup android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp" android:orientation="horizontal" android:id="@+id/genderGroup" android:checkedButton="@id/genderMale">
      <RadioButton android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/gender_background" android:gravity="center" android:text="@string/ui_female" android:textColor="@color/dark_gray" android:textSize="14sp" android:id="@+id/genderFemale" android:buttonTint="@color/kinnect_teal" android:button="@null" android:drawableEnd="@drawable/radio_indicator" android:drawablePadding="4dp" android:paddingHorizontal="10dp" />
      <Space android:layout_width="8dp" android:layout_height="1dp" />
      <RadioButton android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/gender_background" android:gravity="center" android:text="@string/ui_male" android:textColor="@color/dark_gray" android:textSize="14sp" android:id="@+id/genderMale" android:buttonTint="@color/kinnect_teal" android:button="@null" android:drawableEnd="@drawable/radio_indicator" android:drawablePadding="4dp" android:paddingHorizontal="10dp" />
      <Space android:layout_width="8dp" android:layout_height="1dp" />
      <RadioButton android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/gender_background" android:gravity="center" android:text="@string/ui_custom" android:textColor="@color/dark_gray" android:textSize="14sp" android:id="@+id/genderCustom" android:buttonTint="@color/kinnect_teal" android:button="@null" android:drawableEnd="@drawable/radio_indicator" android:drawablePadding="4dp" android:paddingHorizontal="10dp" />
    </RadioGroup>
    <FrameLayout android:layout_width="match_parent" android:layout_height="56dp" android:background="@drawable/rounded_white" android:layout_marginTop="10dp">
      <EditText android:id="@+id/etSignupEmail" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent" android:hint="@string/ui_email" android:inputType="textEmailAddress" android:paddingHorizontal="14dp" android:text="@string/ui_jacob_west_mail_com" android:textColor="@color/dark_gray" android:textColorHint="@color/gray" android:textSize="16sp" android:minHeight="48dp" android:paddingVertical="8dp" android:importantForAutofill="no" android:paddingTop="18dp" android:paddingBottom="2dp" />
      <TextView android:layout_width="wrap_content" android:layout_height="16dp" android:layout_marginStart="14dp" android:layout_marginTop="6dp" android:text="@string/ui_email" android:textSize="12sp" android:textColor="#62655F" android:labelFor="@id/etSignupEmail" android:importantForAccessibility="no" />
    </FrameLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="8dp" android:background="@drawable/rounded_white">
      <EditText android:id="@+id/etSignupPassword" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent" android:hint="@string/ui_new_password" android:inputType="textPassword" android:paddingHorizontal="14dp" android:text="@string/ui_password" android:textColor="@color/dark_gray" android:textColorHint="@color/gray" android:textSize="16sp" android:paddingEnd="48dp" android:importantForAutofill="no" android:paddingTop="18dp" android:paddingBottom="2dp" />
      <ImageButton android:id="@+id/btnPasswordEye" android:layout_width="48dp" android:layout_height="match_parent" android:layout_gravity="end" android:src="@drawable/ic_visibility" android:padding="14dp" android:contentDescription="@string/ui_show_password" android:background="@android:color/transparent" app:tint="#777A73" />
      <TextView android:layout_width="wrap_content" android:layout_height="16dp" android:layout_marginStart="14dp" android:layout_marginTop="6dp" android:text="@string/ui_new_password" android:textSize="12sp" android:textColor="#62655F" android:labelFor="@id/etSignupPassword" android:importantForAccessibility="no" />
    </FrameLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="24dp" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="6dp" android:baselineAligned="false">
      <View android:id="@+id/strength0" android:layout_width="0dp" android:layout_height="4dp" android:layout_weight="1" android:layout_marginEnd="6dp" android:background="@drawable/progress_orange" />
      <View android:id="@+id/strength1" android:layout_width="0dp" android:layout_height="4dp" android:layout_weight="1" android:layout_marginEnd="6dp" android:background="@drawable/progress_orange" />
      <View android:id="@+id/strength2" android:layout_width="0dp" android:layout_height="4dp" android:layout_weight="1" android:layout_marginEnd="6dp" android:background="@drawable/progress_pale" />
      <TextView android:layout_width="60dp" android:layout_height="wrap_content" android:layout_gravity="end" android:layout_marginTop="3dp" android:text="@string/ui_medium" android:textColor="#B85C38" android:textSize="12sp" android:textStyle="bold" android:id="@+id/strengthLabel" android:gravity="end" />
    </LinearLayout>
    <CheckBox android:id="@+id/checkTerms" android:layout_width="match_parent" android:layout_height="wrap_content" android:buttonTint="@color/kinnect_teal" android:checked="true" android:text="@string/ui_i_agree_to_the_kinnect_terms_and_privacy_poli" android:textColor="@color/dark_gray" android:textSize="13sp" />
    <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnCreateAccountSignup" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="4dp" android:background="@drawable/rounded_teal" android:text="@string/ui_create_account" android:textAllCaps="false" android:textColor="@color/white" android:textSize="15sp" android:textStyle="bold" android:backgroundTint="@null" android:letterSpacing="0" app:backgroundTint="@null" />
    <TextView android:id="@+id/tvAlreadyLogin" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:layout_marginTop="10dp" android:text="@string/ui_already_have_an_account_log_in" android:textColor="@color/kinnect_teal" android:textSize="13sp" />
  </LinearLayout>
</ScrollView>