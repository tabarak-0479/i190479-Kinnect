<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <!-- Top bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="‹"
                android:textColor="@color/black"
                android:textSize="30sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Create account"
                android:textColor="@color/black"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Step 2 of 3"
                android:textColor="@color/gray"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- teal progress line -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="3dp"
                android:layout_weight="2"
                android:background="@color/kinnect_teal" />

            <View
                android:layout_width="0dp"
                android:layout_height="3dp"
                android:layout_weight="1"
                android:background="#DDDDDD" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="What’s your name and\nbirthday?"
            android:textColor="@color/black"
            android:textSize="25sp"
            android:textStyle="bold" />

        <!-- Name row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <EditText
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="@drawable/rounded_white"
                android:hint="First name"
                android:paddingHorizontal="14dp"
                android:text="Jacob"
                android:textColor="@color/dark_gray"
                android:textColorHint="@color/gray"
                android:textSize="14sp" />

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <EditText
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="@drawable/rounded_white"
                android:hint="Last name"
                android:paddingHorizontal="14dp"
                android:text="West"
                android:textColor="@color/dark_gray"
                android:textColorHint="@color/gray"
                android:textSize="14sp" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Birthday"
            android:textColor="@color/dark_gray"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Birthday row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/rounded_white"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:text="Day\n14"
                android:textColor="@color/dark_gray"
                android:textSize="13sp" />

            <Space
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/rounded_white"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:text="Month\nMar"
                android:textColor="@color/dark_gray"
                android:textSize="13sp" />

            <Space
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/rounded_white"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:text="Year\n2004"
                android:textColor="@color/dark_gray"
                android:textSize="13sp" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Gender"
            android:textColor="@color/dark_gray"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Gender row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/rounded_white"
                android:gravity="center"
                android:text="Female  ○"
                android:textColor="@color/dark_gray"
                android:textSize="13sp" />

            <Space
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/rounded_teal_border"
                android:gravity="center"
                android:text="Male  ●"
                android:textColor="@color/dark_gray"
                android:textSize="13sp" />

            <Space
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/rounded_white"
                android:gravity="center"
                android:text="Custom  ○"
                android:textColor="@color/dark_gray"
                android:textSize="13sp" />

        </LinearLayout>

        <EditText
            android:id="@+id/etSignupEmail"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/rounded_white"
            android:hint="Email"
            android:inputType="textEmailAddress"
            android:paddingHorizontal="14dp"
            android:text="jacob.west@mail.com"
            android:textColor="@color/dark_gray"
            android:textColorHint="@color/gray"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etSignupPassword"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/rounded_white"
            android:hint="New password"
            android:inputType="textPassword"
            android:paddingHorizontal="14dp"
            android:text="password"
            android:textColor="@color/dark_gray"
            android:textColorHint="@color/gray"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="3dp"
            android:text="Medium"
            android:textColor="#B85C38"
            android:textSize="11sp"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/checkTerms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/kinnect_teal"
            android:checked="true"
            android:text="I agree to the Kinnect Terms and Privacy Policy."
            android:textColor="@color/dark_gray"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnCreateAccountSignup"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/rounded_teal"
            android:text="Create account"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAlreadyLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:text="Already have an account? Log in"
            android:textColor="@color/kinnect_teal"
            android:textSize="13sp" />

    </LinearLayout>

</ScrollView>