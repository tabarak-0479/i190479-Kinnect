<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background" android:fillViewport="true">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
      <TextView android:id="@+id/btnBack" android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="‹" android:textColor="@color/black" android:textSize="30sp" />
      <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Create account" android:textColor="@color/black" android:textSize="20sp" android:textStyle="bold" />
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Step 2 of 3" android:textColor="@color/gray" android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginTop="4dp" android:orientation="horizontal">
      <View android:layout_width="0dp" android:layout_height="3dp" android:layout_weight="2" android:background="@color/kinnect_teal" />
      <View android:layout_width="0dp" android:layout_height="3dp" android:layout_weight="1" android:background="#DDDDDD" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center_vertical" android:orientation="horizontal">
      <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="What’s your name and\nbirthday?" android:textColor="@color/black" android:textSize="25sp" android:textStyle="bold" />
      <FrameLayout android:layout_width="82dp" android:layout_height="82dp">
        <ImageView android:layout_width="68dp" android:layout_height="68dp" android:layout_gravity="center" android:background="@drawable/profile_dashed_circle" android:padding="18dp" android:src="@drawable/ic_person" android:contentDescription="Profile picture" android:id="@+id/signupPerson" app:tint="#62655F" />
        <ImageView android:id="@+id/signupAvatarPhoto" android:layout_width="68dp" android:layout_height="68dp" android:layout_gravity="center" android:background="@drawable/circle_teal" android:clipToOutline="true" android:scaleType="centerCrop" android:visibility="gone" android:contentDescription="Selected profile photo" />
        <ImageView android:layout_width="30dp" android:layout_height="30dp" android:layout_gravity="bottom|end" android:background="@drawable/camera_circle" android:padding="7dp" android:src="@drawable/ic_camera" android:contentDescription="Add profile photo" android:id="@+id/btnSignupPhoto" android:clickable="true" android:focusable="true" app:tint="#62655F" />
      </FrameLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="horizontal">
      <EditText android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/rounded_white" android:hint="First name" android:paddingHorizontal="14dp" android:text="Jacob" android:textColor="@color/dark_gray" android:textColorHint="@color/gray" android:textSize="14sp" android:id="@+id/etFirstName" android:inputType="textPersonName" android:minHeight="48dp" android:paddingVertical="8dp" android:importantForAutofill="no" />
      <Space android:layout_width="10dp" android:layout_height="1dp" />
      <EditText android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/rounded_white" android:hint="Last name" android:paddingHorizontal="14dp" android:text="West" android:textColor="@color/dark_gray" android:textColorHint="@color/gray" android:textSize="14sp" android:id="@+id/etLastName" android:inputType="textPersonName" android:minHeight="48dp" android:paddingVertical="8dp" android:importantForAutofill="no" />
    </LinearLayout>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Birthday" android:textColor="@color/dark_gray" android:textSize="13sp" android:textStyle="bold" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp" android:orientation="horizontal">
      <FrameLayout android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:background="@drawable/rounded_white">
        <Spinner android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent" android:gravity="center_vertical" android:paddingHorizontal="14dp" android:textColor="@color/dark_gray" android:textSize="13sp" android:entries="@array/birthdayDay" android:id="@+id/birthdayDay" android:contentDescription="Day" android:paddingTop="12dp" android:paddingEnd="18dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="14dp" android:layout_marginStart="12dp" android:layout_marginTop="4dp" android:text="Day" android:textSize="10sp" android:textColor="#777A73" android:labelFor="@id/birthdayDay" />
        <ImageView android:layout_width="14dp" android:layout_height="14dp" android:layout_gravity="end|center_vertical" android:layout_marginEnd="8dp" android:src="@drawable/ic_chevron_down" android:importantForAccessibility="no" app:tint="#62655F" />
      </FrameLayout>
      <Space android:layout_width="8dp" android:layout_height="1dp" />
      <FrameLayout android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:background="@drawable/rounded_white">
        <Spinner android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent" android:gravity="center_vertical" android:paddingHorizontal="14dp" android:textColor="@color/dark_gray" android:textSize="13sp" android:entries="@array/birthdayMonth" android:id="@+id/birthdayMonth" android:contentDescription="Month" android:paddingTop="12dp" android:paddingEnd="18dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="14dp" android:layout_marginStart="12dp" android:layout_marginTop="4dp" android:text="Month" android:textSize="10sp" android:textColor="#777A73" android:labelFor="@id/birthdayMonth" />
        <ImageView android:layout_width="14dp" android:layout_height="14dp" android:layout_gravity="end|center_vertical" android:layout_marginEnd="8dp" android:src="@drawable/ic_chevron_down" android:importantForAccessibility="no" app:tint="#62655F" />
      </FrameLayout>
      <Space android:layout_width="8dp" android:layout_height="1dp" />
      <FrameLayout android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:background="@drawable/rounded_white">
        <Spinner android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent" android:gravity="center_vertical" android:paddingHorizontal="14dp" android:textColor="@color/dark_gray" android:textSize="13sp" android:entries="@array/birthdayYear" android:id="@+id/birthdayYear" android:contentDescription="Year" android:paddingTop="12dp" android:paddingEnd="18dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="14dp" android:layout_marginStart="12dp" android:layout_marginTop="4dp" android:text="Year" android:textSize="10sp" android:textColor="#777A73" android:labelFor="@id/birthdayYear" />
        <ImageView android:layout_width="14dp" android:layout_height="14dp" android:layout_gravity="end|center_vertical" android:layout_marginEnd="8dp" android:src="@drawable/ic_chevron_down" android:importantForAccessibility="no" app:tint="#62655F" />
      </FrameLayout>
    </LinearLayout>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Gender" android:textColor="@color/dark_gray" android:textSize="13sp" android:textStyle="bold" />
    <RadioGroup android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp" android:orientation="horizontal" android:id="@+id/genderGroup" android:checkedButton="@id/genderMale">
      <RadioButton android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/rounded_white" android:gravity="center" android:text="Female" android:textColor="@color/dark_gray" android:textSize="12sp" android:id="@+id/genderFemale" android:buttonTint="@color/kinnect_teal" />
      <Space android:layout_width="8dp" android:layout_height="1dp" />
      <RadioButton android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/rounded_teal_border" android:gravity="center" android:text="Male" android:textColor="@color/dark_gray" android:textSize="12sp" android:id="@+id/genderMale" android:buttonTint="@color/kinnect_teal" />
      <Space android:layout_width="8dp" android:layout_height="1dp" />
      <RadioButton android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/rounded_white" android:gravity="center" android:text="Custom" android:textColor="@color/dark_gray" android:textSize="12sp" android:id="@+id/genderCustom" android:buttonTint="@color/kinnect_teal" />
    </RadioGroup>
    <EditText android:id="@+id/etSignupEmail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/rounded_white" android:hint="Email" android:inputType="textEmailAddress" android:paddingHorizontal="14dp" android:text="jacob.west@mail.com" android:textColor="@color/dark_gray" android:textColorHint="@color/gray" android:textSize="14sp" android:minHeight="48dp" android:paddingVertical="8dp" android:importantForAutofill="no" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:background="@drawable/rounded_white">
      <EditText android:id="@+id/etSignupPassword" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent" android:hint="New password" android:inputType="textPassword" android:paddingHorizontal="14dp" android:text="password" android:textColor="@color/dark_gray" android:textColorHint="@color/gray" android:textSize="14sp" android:paddingEnd="48dp" android:importantForAutofill="no" />
      <ImageButton android:id="@+id/btnPasswordEye" android:layout_width="48dp" android:layout_height="match_parent" android:layout_gravity="end" android:src="@drawable/ic_visibility" android:padding="14dp" android:contentDescription="Show password" android:background="@android:color/transparent" app:tint="#777A73" />
    </FrameLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="5dp">
      <View android:layout_width="0dp" android:layout_height="3dp" android:layout_weight="1" android:background="#B94723" android:layout_marginEnd="3dp" />
      <View android:layout_width="0dp" android:layout_height="3dp" android:layout_weight="1" android:background="#D29213" android:layout_marginEnd="3dp" />
      <View android:layout_width="0dp" android:layout_height="3dp" android:layout_weight="1" android:background="#D29213" android:layout_marginEnd="3dp" />
      <View android:layout_width="0dp" android:layout_height="3dp" android:layout_weight="1" android:background="#DDDDD5" android:layout_marginEnd="3dp" />
    </LinearLayout>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end" android:layout_marginTop="3dp" android:text="Medium" android:textColor="#B85C38" android:textSize="11sp" android:textStyle="bold" />
    <CheckBox android:id="@+id/checkTerms" android:layout_width="match_parent" android:layout_height="wrap_content" android:buttonTint="@color/kinnect_teal" android:checked="true" android:text="I agree to the Kinnect Terms and Privacy Policy." android:textColor="@color/dark_gray" android:textSize="12sp" />
    <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnCreateAccountSignup" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="4dp" android:background="@drawable/rounded_teal" android:text="Create account" android:textAllCaps="false" android:textColor="@color/white" android:textSize="15sp" android:textStyle="bold" android:backgroundTint="@null" android:letterSpacing="0" app:backgroundTint="@null" />
    <TextView android:id="@+id/tvAlreadyLogin" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:layout_marginTop="10dp" android:text="Already have an account? Log in" android:textColor="@color/kinnect_teal" android:textSize="13sp" />
  </LinearLayout>
</ScrollView>