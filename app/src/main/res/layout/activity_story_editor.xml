<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#111111">
  <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_margin="8dp" android:background="@drawable/viewfinder" android:clipToOutline="true">
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/landscape_green" android:scaleType="centerCrop" android:contentDescription="@string/ui_landscape_illustration" android:id="@+id/storyImage" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="8dp" android:baselineAligned="false">
      <ImageButton android:layout_width="48dp" android:layout_height="48dp" android:id="@+id/btnBack" android:src="@drawable/ic_close" android:background="@drawable/dark_control" android:padding="12dp" android:contentDescription="@string/ui_back" app:tint="#FFFFFF" />
      <ImageButton android:layout_width="48dp" android:layout_height="48dp" android:id="@+id/toolTag" android:src="@drawable/ic_add_person" android:background="@drawable/dark_control" android:padding="12dp" android:contentDescription="@string/ui_tooltag" app:tint="#FFFFFF" />
      <TextView android:layout_width="48dp" android:layout_height="wrap_content" android:text="@string/ui_aa" android:textSize="20sp" android:textColor="#FFFFFF" android:id="@+id/tool0" android:gravity="center" android:background="@drawable/dark_control" android:clickable="true" android:focusable="true" android:contentDescription="@string/ui_edit_story_text" android:minHeight="48dp" android:paddingVertical="8dp" android:freezesText="true" />
      <ImageButton android:layout_width="48dp" android:layout_height="48dp" android:id="@+id/tool1" android:src="@drawable/ic_smile" android:background="@drawable/dark_control" android:padding="12dp" android:contentDescription="@string/ui_tool1" app:tint="#FFFFFF" />
      <ImageButton android:layout_width="48dp" android:layout_height="48dp" android:id="@+id/tool2" android:src="@drawable/ic_music" android:background="@drawable/dark_control" android:padding="12dp" android:contentDescription="@string/ui_tool2" app:tint="#FFFFFF" />
      <ImageButton android:layout_width="48dp" android:layout_height="48dp" android:id="@+id/tool3" android:src="@drawable/ic_sparkle" android:background="@drawable/dark_control" android:padding="12dp" android:contentDescription="@string/ui_tool3" app:tint="#FFFFFF" />
    </LinearLayout>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_saturday_plans" android:textSize="24sp" android:textColor="#FFFFFF" android:id="@+id/storyCaption" android:textStyle="bold" android:background="@drawable/story_caption" android:padding="12dp" android:layout_gravity="center" android:rotation="3" android:clickable="true" android:focusable="true" android:freezesText="true" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="34sp" android:textColor="#FFFFFF" android:id="@+id/storySticker" android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="90dp" android:visibility="gone" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="14sp" android:textColor="#FFFFFF" android:id="@+id/storyMusic" android:background="@drawable/dark_pill" android:padding="8dp" android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="40dp" android:visibility="gone" />
  </FrameLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="12dp" android:baselineAligned="false">
    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/ui_your_story" android:textSize="14sp" android:textColor="#FFFFFF" android:id="@+id/btnShareStory" android:gravity="center" android:textStyle="bold" android:background="@drawable/button_teal" android:clickable="true" android:focusable="true" android:layout_weight="1" android:layout_marginEnd="8dp" android:minHeight="48dp" android:paddingVertical="8dp" android:freezesText="true" />
    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/ui_close_friends" android:textSize="14sp" android:textColor="#FFFFFF" android:id="@+id/btnCloseFriends" android:gravity="center" android:textStyle="bold" android:background="@drawable/button_teal" android:clickable="true" android:focusable="true" android:layout_weight="1" android:minHeight="48dp" android:paddingVertical="8dp" android:freezesText="true" />
    <ImageButton android:layout_width="48dp" android:layout_height="48dp" android:id="@+id/btnShareArrow" android:src="@drawable/ic_share" android:background="@drawable/circle_teal" android:padding="12dp" android:contentDescription="@string/ui_sharearrow" app:tint="#FFFFFF" />
  </LinearLayout>
</LinearLayout>