<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#111111">
  <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_margin="8dp">
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/landscape_green" android:scaleType="centerCrop" android:contentDescription="Landscape illustration" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
      <ImageButton android:layout_width="48dp" android:layout_height="48dp" android:id="@+id/btnBack" android:src="@drawable/ic_back" android:background="?attr/selectableItemBackgroundBorderless" android:padding="12dp" android:contentDescription="Back" app:tint="#FFFFFF" />
      <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="" android:textSize="14sp" android:textColor="#FFFFFF" android:layout_weight="1" android:textStyle="bold" />
      <TextView android:layout_width="48dp" android:layout_height="48dp" android:text="Aa" android:textSize="14sp" android:textColor="#252722" android:id="@+id/tool0" android:gravity="center" android:textStyle="bold" android:background="@drawable/button_pale" android:clickable="true" android:focusable="true" />
      <TextView android:layout_width="48dp" android:layout_height="48dp" android:text="☺" android:textSize="14sp" android:textColor="#252722" android:id="@+id/tool1" android:gravity="center" android:textStyle="bold" android:background="@drawable/button_pale" android:clickable="true" android:focusable="true" />
      <TextView android:layout_width="48dp" android:layout_height="48dp" android:text="♪" android:textSize="14sp" android:textColor="#252722" android:id="@+id/tool2" android:gravity="center" android:textStyle="bold" android:background="@drawable/button_pale" android:clickable="true" android:focusable="true" />
      <TextView android:layout_width="48dp" android:layout_height="48dp" android:text="✧" android:textSize="14sp" android:textColor="#252722" android:id="@+id/tool3" android:gravity="center" android:textStyle="bold" android:background="@drawable/button_pale" android:clickable="true" android:focusable="true" />
    </LinearLayout>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Saturday plans" android:textSize="24sp" android:textColor="#FFFFFF" android:textStyle="bold" android:background="@drawable/sticker" android:padding="12dp" android:layout_gravity="center" android:rotation="3" android:id="@+id/storyCaption" />
  </FrameLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="12dp">
    <TextView android:layout_width="0dp" android:layout_height="48dp" android:text="Your story" android:textSize="14sp" android:textColor="#FFFFFF" android:id="@+id/btnShareStory" android:gravity="center" android:textStyle="bold" android:background="@drawable/button_teal" android:clickable="true" android:focusable="true" android:layout_weight="1" />
    <TextView android:layout_width="0dp" android:layout_height="48dp" android:text="Close friends" android:textSize="14sp" android:textColor="#FFFFFF" android:id="@+id/btnCloseFriends" android:gravity="center" android:textStyle="bold" android:background="@drawable/button_teal" android:clickable="true" android:focusable="true" android:layout_weight="1" android:layout_marginStart="8dp" />
  </LinearLayout>
</LinearLayout>