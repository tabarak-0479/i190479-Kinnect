<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#111111">
  <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_margin="8dp" android:background="@drawable/viewfinder" android:clipToOutline="true">
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/landscape_green" android:scaleType="centerCrop" android:contentDescription="@string/ui_landscape_illustration" android:id="@+id/cameraPreview" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_margin="8dp">
      <ImageButton android:layout_width="48dp" android:layout_height="48dp" android:id="@+id/btnBrightness" android:src="@drawable/ic_sun" android:background="@drawable/dark_control" android:padding="12dp" android:contentDescription="@string/ui_brightness" android:layout_gravity="start" app:tint="#FFFFFF" />
      <ImageButton android:layout_width="48dp" android:layout_height="48dp" android:id="@+id/btnBack" android:src="@drawable/ic_close" android:background="@drawable/dark_control" android:padding="12dp" android:contentDescription="@string/ui_back" android:layout_gravity="end" app:tint="#FFFFFF" />
    </FrameLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="12dp" android:layout_gravity="bottom" android:baselineAligned="false">
      <ImageButton android:layout_width="48dp" android:layout_height="48dp" android:id="@+id/btnGallery" android:src="@drawable/landscape_sea" android:background="@drawable/circle_white" android:padding="3dp" android:contentDescription="@string/ui_open_photo_gallery" app:tint="@null" />
      <ImageButton android:layout_width="0dp" android:layout_height="48dp" android:id="@+id/btnFlash" android:src="@drawable/ic_flash" android:background="@drawable/dark_control" android:padding="12dp" android:contentDescription="@string/ui_flash" android:layout_weight="1" app:tint="#FFFFFF" />
      <ImageButton android:layout_width="80dp" android:layout_height="80dp" android:id="@+id/btnShutter" android:src="@drawable/shutter" android:background="@android:color/transparent" android:padding="0dp" android:contentDescription="@string/ui_take_picture" app:tint="@null" />
      <ImageButton android:layout_width="0dp" android:layout_height="48dp" android:id="@+id/btnFlip" android:src="@drawable/ic_flip" android:background="@drawable/dark_control" android:padding="12dp" android:contentDescription="@string/ui_flip" android:layout_weight="1" app:tint="#FFFFFF" />
      <ImageButton android:layout_width="48dp" android:layout_height="48dp" android:id="@+id/btnEffects" android:src="@drawable/ic_smile" android:background="@drawable/dark_control" android:padding="12dp" android:contentDescription="@string/ui_effects" app:tint="#FFFFFF" />
    </LinearLayout>
  </FrameLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingBottom="16dp" android:baselineAligned="false">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_text" android:textSize="11sp" android:textColor="#BFC0BB" android:gravity="center" android:textStyle="bold" android:id="@+id/cameraMode0" android:clickable="true" android:focusable="true" android:minHeight="48dp" android:paddingVertical="8dp" android:freezesText="true" />
      <View android:layout_width="match_parent" android:layout_height="2dp" android:background="#111111" />
    </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_live" android:textSize="11sp" android:textColor="#BFC0BB" android:gravity="center" android:textStyle="bold" android:id="@+id/cameraMode1" android:clickable="true" android:focusable="true" android:minHeight="48dp" android:paddingVertical="8dp" android:freezesText="true" />
      <View android:layout_width="match_parent" android:layout_height="2dp" android:background="#111111" />
    </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_story" android:textSize="11sp" android:textColor="#FFFFFF" android:gravity="center" android:textStyle="bold" android:id="@+id/cameraMode2" android:clickable="true" android:focusable="true" android:minHeight="48dp" android:paddingVertical="8dp" android:freezesText="true" />
      <View android:layout_width="match_parent" android:layout_height="2dp" android:background="#FFFFFF" />
    </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_post" android:textSize="11sp" android:textColor="#BFC0BB" android:gravity="center" android:textStyle="bold" android:id="@+id/cameraMode3" android:clickable="true" android:focusable="true" android:minHeight="48dp" android:paddingVertical="8dp" android:freezesText="true" />
      <View android:layout_width="match_parent" android:layout_height="2dp" android:background="#111111" />
    </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_boomerang" android:textSize="11sp" android:textColor="#BFC0BB" android:gravity="center" android:textStyle="bold" android:id="@+id/cameraMode4" android:clickable="true" android:focusable="true" android:minHeight="48dp" android:paddingVertical="8dp" android:freezesText="true" />
      <View android:layout_width="match_parent" android:layout_height="2dp" android:background="#111111" />
    </LinearLayout>
  </LinearLayout>
</LinearLayout>