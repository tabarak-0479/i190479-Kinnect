<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#FFFFFF">
  <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:gravity="center_vertical">
    <ImageButton android:layout_width="48dp" android:layout_height="48dp" android:id="@+id/btnBack" android:src="@drawable/ic_back" android:background="@android:color/transparent" android:padding="12dp" android:contentDescription="Back" app:tint="#0B5F63" />
    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="Jacob West" android:textSize="20sp" android:textColor="#252722" android:layout_weight="1" android:textStyle="bold" android:id="@+id/profileToolbarName" />
    <ImageButton android:layout_width="48dp" android:layout_height="48dp" android:id="@+id/btnSearch" android:src="@drawable/ic_search" android:background="@android:color/transparent" android:padding="12dp" android:contentDescription="Search" app:tint="#0B5F63" />
  </LinearLayout>
  <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#DFDFD8" />
  <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:fillViewport="true" android:layout_weight="1">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
      <FrameLayout android:layout_width="match_parent" android:layout_height="266dp">
        <ImageView android:layout_width="match_parent" android:layout_height="196dp" android:id="@+id/profileCover" android:src="@drawable/cover_sea" android:scaleType="centerCrop" android:contentDescription="Cover photo" />
        <FrameLayout android:layout_width="148dp" android:layout_height="148dp" android:layout_gravity="bottom|start" android:layout_marginStart="16dp" android:background="@drawable/avatar_border">
          <TextView android:layout_width="140dp" android:layout_height="140dp" android:text="JW" android:textSize="46sp" android:textColor="#FFFFFF" android:background="@drawable/circle_teal" android:gravity="center" android:textStyle="bold" android:layout_gravity="center" android:id="@+id/profileAvatar" />
          <ImageView android:layout_width="140dp" android:layout_height="140dp" android:id="@+id/profileAvatarPhoto" android:layout_gravity="center" android:scaleType="centerCrop" android:background="@drawable/circle_teal" android:clipToOutline="true" android:visibility="gone" android:contentDescription="Selected profile picture" />
          <ImageButton android:layout_width="36dp" android:layout_height="36dp" android:id="@+id/avatarCamera" android:src="@drawable/ic_camera" android:background="@drawable/circle_white" android:padding="9dp" android:contentDescription="Edit photo" android:layout_gravity="bottom|end" app:tint="#0B5F63" />
        </FrameLayout>
        <ImageButton android:layout_width="36dp" android:layout_height="36dp" android:id="@+id/coverCamera" android:src="@drawable/ic_camera" android:background="@drawable/circle_white" android:padding="9dp" android:contentDescription="Edit photo" android:layout_gravity="top|end" android:layout_marginTop="144dp" android:layout_marginEnd="16dp" app:tint="#0B5F63" />
      </FrameLayout>
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Jacob West" android:textSize="26sp" android:textColor="#252722" android:gravity="start" android:textStyle="bold" android:id="@+id/profileName" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="834 friends" android:textSize="16sp" android:textColor="#252722" android:gravity="start" android:paddingVertical="6dp" android:id="@+id/ownFriendCount" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Digital goodies designer. Everything is designed." android:textSize="16sp" android:textColor="#252722" android:gravity="start" android:id="@+id/profileBio" />
        <Space android:layout_width="match_parent" android:layout_height="12dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
          <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="Add to story" android:textSize="14sp" android:textColor="#FFFFFF" android:id="@+id/btnPrimary" android:gravity="center" android:textStyle="bold" android:background="@drawable/button_teal" android:clickable="true" android:focusable="true" android:layout_weight="1" android:drawableStart="@drawable/ic_add" android:paddingHorizontal="12dp" android:drawableTint="#FFFFFF" android:minHeight="48dp" android:paddingVertical="8dp" />
          <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="Edit profile" android:textSize="14sp" android:textColor="#252722" android:id="@+id/btnSecondary" android:gravity="center" android:textStyle="bold" android:background="@drawable/button_pale" android:clickable="true" android:focusable="true" android:layout_weight="1" android:layout_marginStart="8dp" android:drawableStart="@drawable/ic_edit" android:paddingHorizontal="12dp" android:minHeight="48dp" android:paddingVertical="8dp" />
          <ImageButton android:layout_width="44dp" android:layout_height="48dp" android:id="@+id/btnProfileMore" android:src="@drawable/ic_more" android:background="@android:color/transparent" android:padding="12dp" android:contentDescription="More" android:backgroundTint="#ECEBE6" app:tint="#0B5F63" />
        </LinearLayout>
        <Space android:layout_width="match_parent" android:layout_height="12dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
          <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="Posts" android:textSize="14sp" android:textColor="#0B5F63" android:layout_weight="1" android:gravity="center" android:textStyle="bold" android:background="@drawable/chip_active" android:id="@+id/profileTab0" android:clickable="true" android:focusable="true" android:minHeight="48dp" android:paddingVertical="8dp" />
          <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="Photos" android:textSize="14sp" android:textColor="#62655F" android:layout_weight="1" android:gravity="center" android:textStyle="bold" android:background="@android:color/transparent" android:id="@+id/profileTab1" android:clickable="true" android:focusable="true" android:minHeight="48dp" android:paddingVertical="8dp" />
          <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="Videos" android:textSize="14sp" android:textColor="#62655F" android:layout_weight="1" android:gravity="center" android:textStyle="bold" android:background="@android:color/transparent" android:id="@+id/profileTab2" android:clickable="true" android:focusable="true" android:minHeight="48dp" android:paddingVertical="8dp" />
          <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="Groups" android:textSize="14sp" android:textColor="#62655F" android:layout_weight="1" android:gravity="center" android:textStyle="bold" android:background="@android:color/transparent" android:id="@+id/profileTab3" android:clickable="true" android:focusable="true" android:minHeight="48dp" android:paddingVertical="8dp" />
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#DFDFD8" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/profileDetailsSection">
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Details" android:textSize="18sp" android:textColor="#252722" android:textStyle="bold" android:padding="16dp" />
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="2dp">
            <ImageButton android:layout_width="36dp" android:layout_height="36dp" android:id="@+id/detailwork" android:src="@drawable/ic_work" android:background="@android:color/transparent" android:padding="7dp" android:contentDescription="Work" android:clickable="false" android:focusable="false" android:importantForAccessibility="no" app:tint="#0B5F63" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="Designer at Pixsellz" android:textSize="16sp" android:textColor="#252722" android:layout_weight="1" android:paddingStart="8dp" />
          </LinearLayout>
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="2dp">
            <ImageButton android:layout_width="36dp" android:layout_height="36dp" android:id="@+id/detailschool" android:src="@drawable/ic_school" android:background="@android:color/transparent" android:padding="7dp" android:contentDescription="School" android:clickable="false" android:focusable="false" android:importantForAccessibility="no" app:tint="#0B5F63" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="Studied at FAST-NUCES" android:textSize="16sp" android:textColor="#252722" android:layout_weight="1" android:paddingStart="8dp" />
          </LinearLayout>
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="2dp">
            <ImageButton android:layout_width="36dp" android:layout_height="36dp" android:id="@+id/detailpin" android:src="@drawable/ic_pin" android:background="@android:color/transparent" android:padding="7dp" android:contentDescription="Pin" android:clickable="false" android:focusable="false" android:importantForAccessibility="no" app:tint="#0B5F63" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="Lives in Karachi, Pakistan" android:textSize="16sp" android:textColor="#252722" android:layout_weight="1" android:paddingStart="8dp" />
          </LinearLayout>
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="2dp">
            <ImageButton android:layout_width="36dp" android:layout_height="36dp" android:id="@+id/detailhistory" android:src="@drawable/ic_history" android:background="@android:color/transparent" android:padding="7dp" android:contentDescription="History" android:clickable="false" android:focusable="false" android:importantForAccessibility="no" app:tint="#0B5F63" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="Joined March 2019" android:textSize="16sp" android:textColor="#252722" android:layout_weight="1" android:paddingStart="8dp" />
          </LinearLayout>
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="Friends" android:textSize="18sp" android:textColor="#252722" android:textStyle="bold" android:padding="16dp" android:layout_weight="1" />
            <TextView android:layout_width="100dp" android:layout_height="wrap_content" android:text="Find friends" android:textSize="14sp" android:textColor="#0B5F63" android:gravity="center" android:textStyle="bold" android:id="@+id/btnFindFriends" android:clickable="true" android:focusable="true" android:minHeight="48dp" android:paddingVertical="8dp" />
          </LinearLayout>
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="834 friends" android:textSize="14sp" android:textColor="#62655F" />
          <Space android:layout_width="match_parent" android:layout_height="12dp" />
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="108dp" android:text="LM" android:textSize="36sp" android:textColor="#FFFFFF" android:layout_weight="1" android:layout_marginEnd="6dp" android:gravity="center" android:background="@drawable/friend_purple" android:id="@+id/profileFriend0" android:clickable="true" android:focusable="true" android:contentDescription="Lina Marsh" />
            <TextView android:layout_width="0dp" android:layout_height="108dp" android:text="AK" android:textSize="36sp" android:textColor="#FFFFFF" android:layout_weight="1" android:layout_marginEnd="6dp" android:gravity="center" android:background="@drawable/friend_red" android:id="@+id/profileFriend1" android:clickable="true" android:focusable="true" android:contentDescription="Aisha Khan" />
            <TextView android:layout_width="0dp" android:layout_height="108dp" android:text="OF" android:textSize="36sp" android:textColor="#FFFFFF" android:layout_weight="1" android:layout_marginEnd="6dp" android:gravity="center" android:background="@drawable/friend_green" android:id="@+id/profileFriend2" android:clickable="true" android:focusable="true" android:contentDescription="Omar Farooq" />
          </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/profileGallerySection" android:visibility="gone">
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <FrameLayout android:layout_width="0dp" android:layout_height="130dp" android:layout_weight="1" android:layout_margin="3dp" android:background="@drawable/card_white" android:clipToOutline="true">
              <ImageView android:layout_width="match_parent" android:layout_height="130dp" android:src="@drawable/landscape_sea" android:scaleType="centerCrop" android:contentDescription="Landscape illustration" />
            </FrameLayout>
            <FrameLayout android:layout_width="0dp" android:layout_height="130dp" android:layout_weight="1" android:layout_margin="3dp" android:background="@drawable/card_white" android:clipToOutline="true">
              <ImageView android:layout_width="match_parent" android:layout_height="130dp" android:src="@drawable/landscape_sand" android:scaleType="centerCrop" android:contentDescription="Landscape illustration" />
            </FrameLayout>
            <FrameLayout android:layout_width="0dp" android:layout_height="130dp" android:layout_weight="1" android:layout_margin="3dp" android:background="@drawable/card_white" android:clipToOutline="true">
              <ImageView android:layout_width="match_parent" android:layout_height="130dp" android:src="@drawable/landscape_pink" android:scaleType="centerCrop" android:contentDescription="Landscape illustration" />
            </FrameLayout>
          </LinearLayout>
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="14sp" android:textColor="#252722" android:id="@+id/profileTabEmpty" android:padding="24dp" android:visibility="gone" />
      </LinearLayout>
    </LinearLayout>
  </ScrollView>
</LinearLayout>