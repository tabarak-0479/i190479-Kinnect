<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#FFFFFF">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="56dp" android:baselineAligned="false">
    <ImageButton android:layout_width="40dp" android:layout_height="48dp" android:id="@+id/btnBack" android:src="@drawable/ic_back" android:background="@android:color/transparent" android:padding="12dp" android:contentDescription="@string/ui_back" app:tint="#0B5F63" />
    <TextView android:layout_width="40dp" android:layout_height="40dp" android:text="@string/ui_ak" android:textSize="18sp" android:textColor="#FFFFFF" android:background="@drawable/circle_red" android:gravity="center" android:textStyle="bold" android:id="@+id/chatAvatar" app:autoSizeTextType="uniform" app:autoSizeMinTextSize="6sp" app:autoSizeMaxTextSize="18sp" app:autoSizeStepGranularity="1sp" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:paddingStart="8dp">
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_aisha_khan" android:textSize="17sp" android:textColor="#252722" android:textStyle="bold" android:id="@+id/chatName" />
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_active_now" android:textSize="12sp" android:textColor="#62655F" />
    </LinearLayout>
    <ImageButton android:layout_width="40dp" android:layout_height="48dp" android:id="@+id/btnCall" android:src="@drawable/ic_phone" android:background="@android:color/transparent" android:padding="12dp" android:contentDescription="@string/ui_phone" app:tint="#0B5F63" />
    <ImageButton android:layout_width="40dp" android:layout_height="48dp" android:id="@+id/btnVideoCall" android:src="@drawable/ic_video" android:background="@android:color/transparent" android:padding="12dp" android:contentDescription="@string/ui_video" app:tint="#0B5F63" />
    <ImageButton android:layout_width="40dp" android:layout_height="48dp" android:id="@+id/btnChatInfo" android:src="@drawable/ic_info" android:background="@android:color/transparent" android:padding="12dp" android:contentDescription="@string/ui_info" app:tint="#0B5F63" />
  </LinearLayout>
  <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#DFDFD8" />
  <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:fillViewport="true" android:layout_weight="1" android:id="@+id/chatScroll">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
      <TextView android:layout_width="72dp" android:layout_height="72dp" android:text="@string/ui_ak" android:textSize="28sp" android:textColor="#FFFFFF" android:background="@drawable/circle_red" android:gravity="center" android:textStyle="bold" android:layout_gravity="center_horizontal" android:layout_marginTop="16dp" android:id="@+id/chatIntroAvatar" app:autoSizeTextType="uniform" app:autoSizeMinTextSize="6sp" app:autoSizeMaxTextSize="28sp" app:autoSizeStepGranularity="1sp" />
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_aisha_khan" android:textSize="20sp" android:textColor="#252722" android:textStyle="bold" android:layout_gravity="center_horizontal" android:paddingTop="12dp" android:id="@+id/chatIntroName" />
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_youre_friends_on_kinnect_lives_in_karachi" android:textSize="12sp" android:textColor="#62655F" android:layout_gravity="center_horizontal" android:paddingTop="8dp" />
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_today_4_49_pm" android:textSize="12sp" android:textColor="#62655F" android:layout_gravity="center_horizontal" android:paddingVertical="20dp" />
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_hey_are_you_still_coming_saturday" android:textSize="16sp" android:textColor="#252722" android:background="@drawable/bubble_in" android:paddingHorizontal="12dp" android:paddingVertical="8dp" android:layout_gravity="start" android:layout_marginStart="48dp" android:layout_marginEnd="12dp" android:layout_marginTop="3dp" />
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_lina_booked_the_table_for_8" android:textSize="16sp" android:textColor="#252722" android:background="@drawable/bubble_in" android:paddingHorizontal="12dp" android:paddingVertical="8dp" android:layout_gravity="start" android:layout_marginStart="48dp" android:layout_marginEnd="12dp" android:layout_marginTop="3dp" />
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingTop="3dp" android:baselineAligned="false">
        <TextView android:layout_width="28dp" android:layout_height="28dp" android:text="@string/ui_ak" android:textSize="18sp" android:textColor="#FFFFFF" android:background="@drawable/circle_red" android:gravity="center" android:textStyle="bold" android:id="@+id/chatLastAvatar" app:autoSizeTextType="uniform" app:autoSizeMinTextSize="6sp" app:autoSizeMaxTextSize="18sp" app:autoSizeStepGranularity="1sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_bring_the_camera" android:textSize="16sp" android:textColor="#252722" android:paddingHorizontal="12dp" android:paddingVertical="8dp" android:background="@drawable/bubble_in" android:layout_marginStart="8dp" />
      </LinearLayout>
      <Space android:layout_width="match_parent" android:layout_height="12dp" />
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_yes_obviously" android:textSize="16sp" android:textColor="#FFFFFF" android:background="@drawable/bubble_out" android:paddingHorizontal="12dp" android:paddingVertical="8dp" android:layout_gravity="end" android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:layout_marginTop="3dp" />
      <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:clipChildren="false">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_already_charged_both_batteries" android:textSize="16sp" android:textColor="#FFFFFF" android:background="@drawable/bubble_out" android:paddingHorizontal="12dp" android:paddingVertical="8dp" android:layout_gravity="end" android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:layout_marginTop="3dp" />
        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_heart" android:background="@drawable/reaction_love" android:padding="5dp" android:layout_gravity="bottom|start" android:layout_marginStart="10dp" android:layout_marginBottom="-8dp" android:contentDescription="@string/ui_love_reaction" app:tint="#FFFFFF" />
      </FrameLayout>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_you_replied_to_aisha" android:textSize="12sp" android:textColor="#62655F" android:layout_gravity="end" android:paddingEnd="16dp" android:paddingTop="12dp" android:id="@+id/quotedReplyLabel" />
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_lina_booked_the_table_for_8" android:textSize="16sp" android:textColor="#FFFFFF" android:background="@drawable/bubble_out" android:paddingHorizontal="12dp" android:paddingVertical="8dp" android:layout_gravity="end" android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:layout_marginTop="3dp" />
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_perfect_ill_be_there_by_7_45" android:textSize="16sp" android:textColor="#FFFFFF" android:background="@drawable/bubble_out" android:paddingHorizontal="12dp" android:paddingVertical="8dp" android:layout_gravity="end" android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:layout_marginTop="3dp" />
      <FrameLayout android:layout_width="200dp" android:layout_height="145dp" android:layout_gravity="end" android:layout_marginEnd="12dp" android:layout_marginTop="4dp" android:background="@drawable/card_white" android:clipToOutline="true">
        <ImageView android:layout_width="200dp" android:layout_height="145dp" android:src="@drawable/landscape_purple" android:scaleType="centerCrop" android:contentDescription="@string/ui_landscape_illustration" />
      </FrameLayout>
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="12dp" android:baselineAligned="false">
        <TextView android:layout_width="28dp" android:layout_height="28dp" android:text="@string/ui_ak" android:textSize="18sp" android:textColor="#FFFFFF" android:background="@drawable/circle_red" android:gravity="center" android:textStyle="bold" android:id="@+id/chatTypingAvatar" app:autoSizeTextType="uniform" app:autoSizeMinTextSize="6sp" app:autoSizeMaxTextSize="18sp" app:autoSizeStepGranularity="1sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_symbol" android:textSize="24sp" android:textColor="#B1AFA7" android:paddingHorizontal="14dp" android:paddingVertical="2dp" android:background="@drawable/bubble_in" android:layout_marginStart="8dp" />
      </LinearLayout>
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/newMessages" />
    </LinearLayout>
  </ScrollView>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="6dp" android:paddingVertical="6dp" android:baselineAligned="false">
    <ImageButton android:layout_width="36dp" android:layout_height="48dp" android:id="@+id/btnChatPlus" android:src="@drawable/ic_add" android:background="@android:color/transparent" android:padding="7dp" android:contentDescription="@string/ui_add" app:tint="#0B5F63" />
    <ImageButton android:layout_width="36dp" android:layout_height="48dp" android:id="@+id/btnCamera" android:src="@drawable/ic_camera" android:background="@android:color/transparent" android:padding="7dp" android:contentDescription="@string/ui_camera" app:tint="#0B5F63" />
    <ImageButton android:layout_width="36dp" android:layout_height="48dp" android:id="@+id/btnPhoto" android:src="@drawable/ic_image" android:background="@android:color/transparent" android:padding="7dp" android:contentDescription="@string/ui_image" app:tint="#0B5F63" />
    <ImageButton android:layout_width="36dp" android:layout_height="48dp" android:id="@+id/btnChatMic" android:src="@drawable/ic_mic" android:background="@android:color/transparent" android:padding="7dp" android:contentDescription="@string/ui_mic" app:tint="#0B5F63" />
    <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
      <EditText android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/etMessage" android:hint="@string/ui_aa" android:text="" android:textSize="15sp" android:textColor="#252722" android:textColorHint="#70736D" android:paddingHorizontal="12dp" android:background="@drawable/button_pale" android:inputType="textCapSentences|textMultiLine" android:paddingEnd="36dp" android:minHeight="48dp" android:paddingVertical="8dp" android:importantForAutofill="no" />
      <ImageButton android:layout_width="36dp" android:layout_height="44dp" android:id="@+id/btnChatSmile" android:src="@drawable/ic_smile" android:background="@android:color/transparent" android:padding="7dp" android:contentDescription="@string/ui_smile" android:layout_gravity="end" app:tint="#0B5F63" />
    </FrameLayout>
    <ImageButton android:layout_width="40dp" android:layout_height="48dp" android:id="@+id/btnChatLike" android:src="@drawable/ic_like" android:background="@android:color/transparent" android:padding="12dp" android:contentDescription="@string/ui_like" app:tint="#0B5F63" />
    <ImageButton android:layout_width="40dp" android:layout_height="48dp" android:id="@+id/btnSend" android:src="@drawable/ic_send" android:background="@android:color/transparent" android:padding="12dp" android:contentDescription="@string/ui_send" android:visibility="gone" app:tint="#0B5F63" />
  </LinearLayout>
</LinearLayout>