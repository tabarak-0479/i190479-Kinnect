<?xml version="1.0" ?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#FFFFFF">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageButton android:layout_width="48dp" android:layout_height="48dp" android:id="@+id/btnBack" android:src="@drawable/ic_back" android:background="?attr/selectableItemBackgroundBorderless" android:padding="12dp" android:contentDescription="Back"/>
        <TextView android:layout_width="40dp" android:layout_height="40dp" android:text="AK" android:textSize="18sp" android:textColor="#FFFFFF" android:background="@drawable/circle_red" android:gravity="center" android:textStyle="bold"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:paddingStart="8dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Aisha Khan" android:textSize="17sp" android:textColor="#252722" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Active now" android:textSize="12sp" android:textColor="#252722"/>
        </LinearLayout>
        <ImageButton android:layout_width="48dp" android:layout_height="48dp" android:id="@+id/btnCall" android:src="@drawable/ic_phone" android:background="?attr/selectableItemBackgroundBorderless" android:padding="12dp" android:contentDescription="Phone"/>
        <ImageButton android:layout_width="48dp" android:layout_height="48dp" android:id="@+id/btnVideoCall" android:src="@drawable/ic_video" android:background="?attr/selectableItemBackgroundBorderless" android:padding="12dp" android:contentDescription="Video"/>
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#DFDFD8"/>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:fillViewport="true" android:layout_weight="1" android:id="@+id/chatScroll">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="72dp" android:layout_height="72dp" android:text="AK" android:textSize="18sp" android:textColor="#FFFFFF" android:background="@drawable/circle_red" android:gravity="center" android:textStyle="bold" android:layout_gravity="center" android:layout_marginTop="16dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Aisha Khan" android:textSize="22sp" android:textColor="#252722" android:textStyle="bold" android:layout_gravity="center" android:padding="10dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="You’re friends on Kinnect · Lives in Karachi" android:textSize="12sp" android:textColor="#252722" android:layout_gravity="center"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TODAY 4:49 PM" android:textSize="14sp" android:textColor="#252722" android:layout_gravity="center" android:padding="20dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hey! Are you still coming Saturday?" android:textSize="14sp" android:textColor="#252722" android:background="@drawable/bubble_in" android:padding="12dp" android:layout_gravity="start" android:layout_marginTop="4dp" android:layout_marginStart="40dp" android:layout_marginEnd="50dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Lina booked the table for 8" android:textSize="14sp" android:textColor="#252722" android:background="@drawable/bubble_in" android:padding="12dp" android:layout_gravity="start" android:layout_marginTop="4dp" android:layout_marginStart="40dp" android:layout_marginEnd="50dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bring the camera" android:textSize="14sp" android:textColor="#252722" android:background="@drawable/bubble_in" android:padding="12dp" android:layout_gravity="start" android:layout_marginTop="4dp" android:layout_marginStart="40dp" android:layout_marginEnd="50dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Yes, obviously" android:textSize="14sp" android:textColor="#FFFFFF" android:background="@drawable/bubble_out" android:padding="12dp" android:layout_gravity="end" android:layout_marginTop="4dp" android:layout_marginStart="80dp" android:layout_marginEnd="12dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Already charged both batteries" android:textSize="14sp" android:textColor="#FFFFFF" android:background="@drawable/bubble_out" android:padding="12dp" android:layout_gravity="end" android:layout_marginTop="4dp" android:layout_marginStart="80dp" android:layout_marginEnd="12dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="You replied to Aisha" android:textSize="12sp" android:textColor="#252722" android:layout_gravity="end" android:padding="12dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Lina booked the table for 8" android:textSize="14sp" android:textColor="#FFFFFF" android:background="@drawable/bubble_out" android:padding="12dp" android:layout_gravity="end" android:layout_marginTop="4dp" android:layout_marginStart="80dp" android:layout_marginEnd="12dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Perfect, I’ll be there by 7:45" android:textSize="14sp" android:textColor="#FFFFFF" android:background="@drawable/bubble_out" android:padding="12dp" android:layout_gravity="end" android:layout_marginTop="4dp" android:layout_marginStart="80dp" android:layout_marginEnd="12dp"/>
            <ImageView android:layout_width="210dp" android:layout_height="150dp" android:src="@drawable/landscape_pink" android:scaleType="centerCrop" android:contentDescription="Landscape illustration" android:layout_gravity="end" android:layout_margin="12dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="•••" android:textSize="14sp" android:textColor="#252722" android:background="@drawable/bubble_in" android:padding="12dp" android:layout_gravity="start" android:layout_marginTop="4dp" android:layout_marginStart="40dp" android:layout_marginEnd="50dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/newMessages"/>
            <Space android:layout_width="match_parent" android:layout_height="12dp"/>
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageButton android:layout_width="48dp" android:layout_height="48dp" android:id="@+id/btnCamera" android:src="@drawable/ic_camera" android:background="?attr/selectableItemBackgroundBorderless" android:padding="12dp" android:contentDescription="Camera"/>
        <ImageButton android:layout_width="48dp" android:layout_height="48dp" android:id="@+id/btnPhoto" android:src="@drawable/ic_image" android:background="?attr/selectableItemBackgroundBorderless" android:padding="12dp" android:contentDescription="Image"/>
        <EditText android:layout_width="0dp" android:layout_height="48dp" android:id="@+id/etMessage" android:hint="Aa" android:text="" android:textSize="15sp" android:textColor="#252722" android:textColorHint="#70736D" android:paddingHorizontal="12dp" android:background="@drawable/button_pale" android:inputType="textCapSentences" android:layout_weight="1"/>
        <ImageButton android:layout_width="48dp" android:layout_height="48dp" android:id="@+id/btnSend" android:src="@drawable/ic_share" android:background="?attr/selectableItemBackgroundBorderless" android:padding="12dp" android:contentDescription="Share"/>
    </LinearLayout>
</LinearLayout>
