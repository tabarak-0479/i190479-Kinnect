<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center" android:background="#0B5F63" android:padding="16dp" android:baselineAligned="false">
  <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
    <TextView android:layout_width="100dp" android:layout_height="100dp" android:text="@string/ui_am" android:textSize="36sp" android:textColor="#FFFFFF" android:gravity="center" android:textStyle="bold" android:background="@drawable/call_avatar" android:layout_gravity="center" android:id="@+id/callAvatar" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_ammi" android:textSize="24sp" android:textColor="#FFFFFF" android:textStyle="bold" android:id="@+id/callName" android:layout_gravity="center_horizontal" />
    <Chronometer android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/callDuration" android:text="@string/ui_03_12" android:textSize="20sp" android:textColor="#BFDCDD" android:layout_gravity="center_horizontal" android:layout_marginTop="10dp" />
  </LinearLayout>
  <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="88dp" android:orientation="horizontal" android:gravity="center" android:baselineAligned="false">
      <FrameLayout android:layout_width="0dp" android:layout_height="88dp" android:layout_weight="1">
        <ImageButton android:layout_width="56dp" android:layout_height="56dp" android:id="@+id/btnKeypad" android:src="@drawable/ic_keypad" android:background="@drawable/call_control" android:padding="18dp" android:contentDescription="@string/ui_keypad" android:layout_gravity="center" app:tint="#0B5F63" />
      </FrameLayout>
      <FrameLayout android:layout_width="0dp" android:layout_height="88dp" android:layout_weight="1">
        <ImageButton android:layout_width="56dp" android:layout_height="56dp" android:id="@+id/btnMute" android:src="@drawable/ic_mic" android:background="@drawable/call_control" android:padding="18dp" android:contentDescription="@string/ui_mic" android:layout_gravity="center" app:tint="#0B5F63" />
      </FrameLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="88dp" android:orientation="horizontal" android:gravity="center" android:baselineAligned="false">
      <FrameLayout android:layout_width="0dp" android:layout_height="88dp" android:layout_weight="1">
        <ImageButton android:layout_width="80dp" android:layout_height="80dp" android:id="@+id/btnEndCall" android:src="@drawable/ic_end_phone" android:background="@drawable/call_end" android:padding="18dp" android:contentDescription="@string/ui_end_phone" android:layout_gravity="center" app:tint="#0B5F63" />
      </FrameLayout>
      <FrameLayout android:layout_width="0dp" android:layout_height="88dp" android:layout_weight="1">
        <ImageButton android:layout_width="56dp" android:layout_height="56dp" android:id="@+id/btnSpeaker" android:src="@drawable/ic_speaker" android:background="@drawable/call_control" android:padding="18dp" android:contentDescription="@string/ui_speaker" android:layout_gravity="center" app:tint="#0B5F63" />
      </FrameLayout>
    </LinearLayout>
  </LinearLayout>
</LinearLayout>